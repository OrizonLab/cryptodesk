---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
  related?: CollectionEntry<'posts'>[];
}

const { post, prev, next, related = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, ogImage, enSlug } = post.data;

const dateFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
// Heure de publication affichée en petit dans le meta — forcée sur Paris
// (le site est statique : sans timeZone, le build UTC afficherait l'heure UTC)
const timeFmt = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });
const hasTime = pubDate.getUTCHours() !== 0 || pubDate.getUTCMinutes() !== 0;
const pubTime = hasTime ? timeFmt.format(pubDate) : null;
const enHref = enSlug ? `https://cryptodesk.fr/en/posts/${enSlug}/` : undefined;

// Temps de lecture estimé
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readMin = Math.max(1, Math.round(wordCount / 200));

// JSON-LD Article
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: 'CryptoDesk', url: 'https://cryptodesk.fr/' },
  publisher: {
    '@type': 'Organization',
    name: 'CryptoDesk',
    logo: { '@type': 'ImageObject', url: 'https://cryptodesk.fr/favicon.svg' },
  },
  mainEntityOfPage: `https://cryptodesk.fr/posts/${post.slug}/`,
  inLanguage: 'fr-FR',
  ...(ogImage ? { image: ogImage } : {}),
  keywords: tags.join(', '),
};

// Breadcrumbs JSON-LD
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://cryptodesk.fr/' },
    { '@type': 'ListItem', position: 2, name: title, item: `https://cryptodesk.fr/posts/${post.slug}/` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  article={{
    publishedTime: pubDate.toISOString(),
    ...(updatedDate ? { modifiedTime: updatedDate.toISOString() } : {}),
    tags,
    authorName: 'CryptoDesk',
    authorUrl: 'https://cryptodesk.fr/a-propos/',
  }}
  alternateHref={enHref}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <article class="container post">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}{pubTime ? ` · ${pubTime}` : ''}</time>
        <span class="read-time">· ⏱️ {readMin} min de lecture</span>
        {updatedDate && <span class="updated">· mis à jour {dateFmt.format(updatedDate)}</span>}
        {enHref && (
          <span class="lang-switch">
            · <a href={enHref} hreflang="en">🇺🇸 Read in English</a>
          </span>
        )}
      </div>
      <h1 class="post-title">{title}</h1>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <aside class="affiliate" aria-label="Exchanges partenaires">
      <p class="affiliate-title">🏦 Nos exchanges partenaires</p>
      <p class="affiliate-intro">
        Tu veux acheter du crypto ? Passer par ces liens ne te coûte rien de plus
        et soutient le blog :
      </p>
      <ul class="affiliate-list">
        <li><a href="https://bitvavo.com/invite?a=5CC31560CE" target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate="bitvavo">Bitvavo</a> — exchange européen, simple et régulé</li>
        <li><a href="https://bitstack-app.com/referral/2softk0f6gUhcTpxoxAUqPd0gfK" target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate="bitstack">Bitstack</a> — épargne Bitcoin au quotidien (bonus BTC)</li>
        <li><a href="https://my.okx.com/fr-fr/join/77244970" target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate="okx">OKX</a> — jusqu'à 150 € de bonus (code 77244970)</li>
        <li><a href="https://weex.com/register?vipCode=4flde" target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate="weex">WEEX</a> — dérivés & copy trading (code 4flde)</li>
        <li><a href="https://www.bitgetapps.com/referral/register?clacCode=W8JDT92M" target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate="bitget">Bitget</a> — copy trading & futures (code W8JDT92M)</li>
        <li><a href="https://aave.com/r/2BA113" target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate="aave">Aave</a> — accès anticipé au protocole V4</li>
      </ul>
      <p class="affiliate-note">Liens d'affiliation — transparence : <a href="/partenaires/">voir la page Partenaires</a></p>
    </aside>

    {related.length > 0 && (
      <nav class="read-next" aria-label="À lire ensuite">
        <p class="read-next-title">📰 À lire ensuite</p>
        <div class="read-next-grid">
          {related.map((r) => (
            <a class="read-next-card" href={`/posts/${r.slug}/`}>
              <span class="rn-cta">Lire l'article →</span>
              <h3>{r.data.title}</h3>
              <p>{r.data.description}</p>
            </a>
          ))}
        </div>
      </nav>
    )}

    <nav class="post-nav" aria-label="Navigation entre articles">
      {prev && <a class="nav-link prev" href={`/posts/${prev.slug}/`}>← {prev.data.title}</a>}
      {next && <a class="nav-link next" href={`/posts/${next.slug}/`}>{next.data.title} →</a>}
    </nav>
  </article>

  <style>
    .post { padding-top: 2.5rem; }
    .post-header { margin-bottom: 2.2rem; }
    .post-meta { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
    .read-time { color: var(--text-muted); font-size: 0.82rem; }
    .post-title {
      font-size: clamp(1.7rem, 4.5vw, 2.5rem);
      line-height: 1.18;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }
    .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .lang-switch a { color: var(--accent); text-decoration: none; font-weight: 600; }
    .lang-switch a:hover { text-decoration: underline; }
    .tag {
      color: var(--accent);
      background: var(--accent-glow);
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s;
    }
    .tag:hover { background: var(--accent-soft); }

    .post-nav {
      display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    }
    .nav-link { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; max-width: 45%; transition: color 0.15s; }
    .nav-link:hover { color: var(--accent); }
    .nav-link.next { text-align: right; }

    /* ── À lire ensuite ── */
    .read-next { margin-top: 3rem; }
    .read-next-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text); }
    .read-next-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .read-next-card {
      display: flex; flex-direction: column-reverse;
      background: var(--card);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.2rem 1.4rem 1.4rem;
      text-decoration: none; color: inherit;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.18s, transform 0.15s, box-shadow 0.15s;
    }
    .read-next-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
    .read-next-card h3 {
      font-size: 1.05rem; font-weight: 700; line-height: 1.3;
      margin-bottom: 0.35rem; color: var(--text);
    }
    .read-next-card p {
      color: var(--text-muted); font-size: 0.88rem; line-height: 1.45;
      flex: 1; margin-bottom: 0.5rem;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .rn-cta {
      color: var(--accent); font-weight: 600; font-size: 0.82rem;
      text-transform: uppercase; letter-spacing: 0.03em;
      margin-top: 0.3rem;
    }

    /* ── Affiliés ── */
    .affiliate {
      margin-top: 3rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.4rem 1.6rem;
      box-shadow: var(--shadow-sm);
    }
    .affiliate-title { font-weight: 700; margin-bottom: 0.4rem; font-size: 1.05rem; }
    .affiliate-intro { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.6rem; }
    .affiliate-list { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
    .affiliate-list li { color: var(--text-muted); font-size: 0.9rem; }
    .affiliate-list a { color: var(--accent); font-weight: 600; text-decoration: none; }
    .affiliate-list a:hover { text-decoration: underline; }
    .affiliate-note { margin-top: 0.75rem; font-size: 0.78rem; color: var(--text-muted); opacity: 0.8; }
    .affiliate-note a { color: var(--text-muted); text-decoration: underline; }

    @media (max-width: 480px) {
      .nav-link { max-width: 100%; }
    }
  </style>
</BaseLayout>
