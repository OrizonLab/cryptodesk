---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, ogImage } = post.data;

const dateFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// JSON-LD Article
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: 'CryptoDesk', url: 'https://blog.auratrade.app/' },
  publisher: {
    '@type': 'Organization',
    name: 'CryptoDesk',
    logo: { '@type': 'ImageObject', url: 'https://blog.auratrade.app/favicon.svg' },
  },
  mainEntityOfPage: `https://blog.auratrade.app/posts/${post.slug}/`,
  inLanguage: 'fr-FR',
  ...(ogImage ? { image: ogImage } : {}),
  keywords: tags.join(', '),
};

// Breadcrumbs JSON-LD
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://blog.auratrade.app/' },
    { '@type': 'ListItem', position: 2, name: title, item: `https://blog.auratrade.app/posts/${post.slug}/` },
  ],
};
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <article class="container post">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}</time>
        {updatedDate && <span class="updated">· mis à jour {dateFmt.format(updatedDate)}</span>}
      </div>
      <h1 class="post-title">{title}</h1>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((t) => <a class="tag" href={`/tags/${t}/`}>#{t}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <aside class="affiliate" aria-label="Exchanges partenaires">
      <p class="affiliate-title">🏦 Nos exchanges partenaires</p>
      <p class="affiliate-intro">
        Tu veux acheter du crypto ? Passer par ces liens ne te coûte rien de plus
        et soutient le blog :
      </p>
      <ul class="affiliate-list">
        <li><a href="https://bitvavo.com/invite?a=5CC31560CE" target="_blank" rel="noopener sponsored nofollow">Bitvavo</a> — exchange européen, simple et régulé</li>
        <li><a href="https://bitstack-app.com/referral/2softk0f6gUhcTpxoxAUqPd0gfK" target="_blank" rel="noopener sponsored nofollow">Bitstack</a> — épargne Bitcoin au quotidien (bonus BTC)</li>
        <li><a href="https://my.okx.com/fr-fr/join/77244970" target="_blank" rel="noopener sponsored nofollow">OKX</a> — jusqu'à 150 € de bonus (code 77244970)</li>
        <li><a href="https://weex.com/register?vipCode=4flde" target="_blank" rel="noopener sponsored nofollow">WEEX</a> — dérivés & copy trading (code 4flde)</li>
      </ul>
      <p class="affiliate-note">Liens d'affiliation — transparence : <a href="/partenaires/">voir la page Partenaires</a></p>
    </aside>

    <nav class="post-nav" aria-label="Navigation entre articles">
      {prev && <a class="nav-link prev" href={`/posts/${prev.slug}/`}>← {prev.data.title}</a>}
      {next && <a class="nav-link next" href={`/posts/${next.slug}/`}>{next.data.title} →</a>}
    </nav>
  </article>

  <style>
    .post { padding-top: 2rem; }
    .post-header { margin-bottom: 2rem; }
    .post-meta { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem; }
    .post-title {
      font-size: clamp(1.6rem, 4vw, 2.3rem);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -0.015em;
      margin-bottom: 0.9rem;
    }
    .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .tag {
      color: var(--accent);
      background: var(--accent-soft);
      padding: 0.12rem 0.6rem;
      border-radius: 999px;
      font-size: 0.8rem;
      text-decoration: none;
    }

    .post-nav {
      display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    }
    .nav-link { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; max-width: 45%; }
    .nav-link:hover { color: var(--accent); }
    .nav-link.next { text-align: right; }

    .affiliate {
      margin-top: 3rem;
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
    }
    .affiliate-title { font-weight: 700; margin-bottom: 0.4rem; }
    .affiliate-intro { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.6rem; }
    .affiliate-list { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
    .affiliate-list li { color: var(--text-muted); font-size: 0.9rem; }
    .affiliate-list a { color: var(--accent); font-weight: 600; text-decoration: none; }
    .affiliate-list a:hover { text-decoration: underline; }
    .affiliate-note { margin-top: 0.75rem; font-size: 0.78rem; color: var(--text-muted); opacity: 0.8; }
    .affiliate-note a { color: var(--text-muted); text-decoration: underline; }

    @media (max-width: 480px) {
      .nav-link { max-width: 100%; }
    }
  </style>
</BaseLayout>
