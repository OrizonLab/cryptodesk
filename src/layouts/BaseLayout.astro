---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  /** Langue de la page ('fr' par défaut) — ajuste og:locale */
  lang?: 'fr' | 'en';
  /** URL de la version dans l'autre langue (hreflang) */
  alternateHref?: string;
  /** Métadonnées d'article (OG + JSON-LD renforcé pour les IA) */
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    tags?: string[];
    authorName?: string;
    authorUrl?: string;
  };
}

const { title, description, ogImage, ogType, canonical, article, lang = 'fr', alternateHref } = Astro.props;
const isEn = lang === 'en';
const pageTitle = title ? `${title} — CryptoDesk` : 'CryptoDesk — Cryptos & Marchés Financiers';
const pageDesc = description ?? 'CryptoDesk — analyses, actualités et décryptages sur les cryptomonnaies et les marchés financiers.';
const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// Normalise l'URL de l'image OG (évite le double slash quand Astro.site finit par /)
const pageOgImage = ogImage ? new URL(ogImage, Astro.site).href : new URL('/og-default.png', Astro.site).href;

const navItems = [
  { href: '/', label: 'Accueil' },
  { href: '/lexique/', label: 'Lexique' },
  { href: '/themes/', label: 'Thèmes' },
  { href: '/donnees/', label: 'Données' },
  { href: '/comparateur/', label: 'Comparateur' },
  { href: '/partenaires/', label: 'Partenaires' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/newsletter/', label: 'Newsletter', pill: true },
];
---

<!doctype html>
<html lang={isEn ? 'en' : 'fr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>

    <!-- SEO de base -->
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="CryptoDesk" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0f1115" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:site_name" content="CryptoDesk" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'fr_FR'} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CryptoDesk — Cryptos & Marchés Financiers" />

    {
      alternateHref && (
        <>
          {/* hreflang : signale à Google la version dans l'autre langue */}
          <link rel="alternate" hreflang={isEn ? 'fr' : 'en'} href={alternateHref} />
          <link rel="alternate" hreflang="x-default" href={isEn ? pageUrl : alternateHref} />
        </>
      )
    }

    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
          <meta property="article:author" content={article.authorName ?? 'CryptoDesk'} />
          {article.tags?.slice(0, 6).map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={pageOgImage} />

    <!-- Flux RSS -->
    <link rel="alternate" type="application/rss+xml" title="CryptoDesk — RSS" href={`${Astro.site}/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="CryptoDesk — Atom" href={`${Astro.site}/rss.xml`} />

    <!-- LLM SEO -->
    <link rel="llms.txt" href={`${Astro.site}/llms.txt`} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Thème clair/sombre/système — chargé SYNCHRONE pour éviter le flash -->
    <script src="/js/theme.js" is:inline></script>

    <!-- Web analytics (Umami self-hosted — stats.cryptodesk.fr) -->
    <script
      defer
      src="https://stats.cryptodesk.fr/cd"
      data-website-id="3b37718d-2ed6-4b2e-91c2-e2fef8d83454"
    ></script>

    <style>
      /* Bandeau de langue (injecté par JS si le navigateur est dans l'autre langue) */
      .lang-banner {
        position: sticky; top: 0; z-index: 100;
        background: var(--accent); color: #fff;
        text-align: center; font-size: 0.9rem; font-weight: 600;
        padding: 0.55rem 1rem;
      }
      .lang-banner a { color: #fff; text-decoration: underline; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <nav class="nav container" aria-label="Navigation principale">
        <a href="/" class="brand" aria-label="CryptoDesk — accueil">
          <img src="/logo.png" alt="" class="brand-logo" width="30" height="30" />
          <span class="brand-name">CryptoDesk</span>
        </a>

        <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
          <span></span><span></span><span></span>
        </button>

        <ul class="nav-links" id="nav-menu">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[item.pill && 'rss-link']}
                aria-current={Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Thème" title="Clair / Sombre / Système">🌙</button>
          </li>
        </ul>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-grid">
          <div>
            <p class="footer-brand"><img src="/logo.png" alt="" class="brand-logo" width="26" height="26" /> CryptoDesk</p>
            <p class="footer-desc">Analyses sobres et documentées sur les cryptomonnaies, la régulation et les marchés financiers.</p>
          </div>
          <div class="footer-links">
            <a href="/lexique/">Lexique</a>
            <a href="/themes/">Thèmes</a>
            <a href="/donnees/">Données</a>
            <a href="/comparateur/">Comparateur</a>
            <a href="/partenaires/">Partenaires</a>
            <a href="/newsletter/">Newsletter</a>
          </div>
          <div class="footer-links">
            <a href="/a-propos/">À propos</a>
            <a href="/rss.xml">Flux RSS</a>
            <a href="/llms.txt">llms.txt</a>
            <a href="/sitemap-index.xml">Sitemap</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} CryptoDesk — Cryptos & marchés financiers</p>
          <p class="footer-note">⚠️ Contenu informatif — pas un conseil en investissement.</p>
        </div>
      </div>
    </footer>

    <!-- Scripts globaux (menu mobile + bandeau langue) — fichier EXTERNE car la
         CSP du blog (script-src 'self') bloque les scripts inline -->
    <script src="/js/main.js" defer></script>
  </body>
</html>
