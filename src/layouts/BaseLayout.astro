---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  /** Métadonnées d'article (OG + JSON-LD renforcé pour les IA) */
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    tags?: string[];
    authorName?: string;
    authorUrl?: string;
  };
}

const { title, description, ogImage, ogType, canonical, article } = Astro.props;
const pageTitle = title ? `${title} — CryptoDesk` : 'CryptoDesk — Cryptos & Marchés Financiers';
const pageDesc = description ?? 'CryptoDesk — analyses, actualités et décryptages sur les cryptomonnaies et les marchés financiers.';
const pageUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const pageOgImage = ogImage ?? `${Astro.site}/og-default.png`;

const navItems = [
  { href: '/', label: 'Accueil' },
  { href: '/lexique/', label: 'Lexique' },
  { href: '/themes/', label: 'Thèmes' },
  { href: '/donnees/', label: 'Données' },
  { href: '/comparateur/', label: 'Comparateur' },
  { href: '/partenaires/', label: 'Partenaires' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/newsletter/', label: 'Newsletter', pill: true },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>

    <!-- SEO de base -->
    <meta name="description" content={pageDesc} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="CryptoDesk" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#0f1115" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType ?? 'website'} />
    <meta property="og:site_name" content="CryptoDesk" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CryptoDesk — Cryptos & Marchés Financiers" />

    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
          <meta property="article:author" content={article.authorName ?? 'CryptoDesk'} />
          {article.tags?.slice(0, 6).map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={pageOgImage} />

    <!-- Flux RSS -->
    <link rel="alternate" type="application/rss+xml" title="CryptoDesk — RSS" href={`${Astro.site}/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="CryptoDesk — Atom" href={`${Astro.site}/rss.xml`} />

    <!-- LLM SEO -->
    <link rel="llms.txt" href={`${Astro.site}/llms.txt`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <style>
      /* Anti-FOUC : applique le bon color-scheme avant le rendu */
      html { color-scheme: light dark; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <nav class="nav container" aria-label="Navigation principale">
        <a href="/" class="brand" aria-label="CryptoDesk — accueil">
          <span class="brand-mark">⌁</span>
          <span class="brand-name">CryptoDesk</span>
        </a>

        <button class="nav-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
          <span></span><span></span><span></span>
        </button>

        <ul class="nav-links" id="nav-menu">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[item.pill && 'rss-link']}
                aria-current={Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-grid">
          <div>
            <p class="footer-brand"><span class="brand-mark">⌁</span> CryptoDesk</p>
            <p class="footer-desc">Analyses sobres et documentées sur les cryptomonnaies, la régulation et les marchés financiers.</p>
          </div>
          <div class="footer-links">
            <a href="/lexique/">Lexique</a>
            <a href="/themes/">Thèmes</a>
            <a href="/donnees/">Données</a>
            <a href="/comparateur/">Comparateur</a>
            <a href="/partenaires/">Partenaires</a>
            <a href="/newsletter/">Newsletter</a>
          </div>
          <div class="footer-links">
            <a href="/a-propos/">À propos</a>
            <a href="/rss.xml">Flux RSS</a>
            <a href="/llms.txt">llms.txt</a>
            <a href="/sitemap-index.xml">Sitemap</a>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} CryptoDesk — Cryptos & marchés financiers</p>
          <p class="footer-note">⚠️ Contenu informatif — pas un conseil en investissement.</p>
        </div>
      </div>
    </footer>

    <script>
      // Menu mobile : toggle + fermeture au clic sur un lien
      const toggle = document.querySelector('[data-nav-toggle]');
      const menu = document.getElementById('nav-menu');
      if (toggle && menu) {
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!open));
          menu.classList.toggle('open');
          document.body.classList.toggle('nav-open');
        });
        menu.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => {
            toggle.setAttribute('aria-expanded', 'false');
            menu.classList.remove('open');
            document.body.classList.remove('nav-open');
          })
        );
      }
    </script>
  </body>
</html>
