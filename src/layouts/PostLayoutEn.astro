---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'postsEn'>;
  prev?: CollectionEntry<'postsEn'>;
  next?: CollectionEntry<'postsEn'>;
  related?: CollectionEntry<'postsEn'>[];
}

const { post, prev, next, related = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, ogImage, frSlug } = post.data;

const dateFmt = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
// Publication time (ET) — les analyses US sortent après la clôture des marchés
const timeFmt = new Intl.DateTimeFormat('en-US', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'America/New_York',
});
const hasTime = pubDate.getUTCHours() !== 0 || pubDate.getUTCMinutes() !== 0;
const pubTime = hasTime ? timeFmt.format(pubDate) : null;
const frHref = frSlug ? `https://cryptodesk.fr/posts/${frSlug}/` : undefined;

// JSON-LD Article
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: 'CryptoDesk', url: 'https://cryptodesk.fr/' },
  publisher: {
    '@type': 'Organization',
    name: 'CryptoDesk',
    logo: { '@type': 'ImageObject', url: 'https://cryptodesk.fr/favicon.svg' },
  },
  mainEntityOfPage: `https://cryptodesk.fr/en/posts/${post.slug}/`,
  inLanguage: 'en-US',
  ...(ogImage ? { image: ogImage } : {}),
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  lang="en"
  alternateHref={frHref}
  article={{
    publishedTime: pubDate.toISOString(),
    ...(updatedDate ? { modifiedTime: updatedDate.toISOString() } : {}),
    tags,
    authorName: 'CryptoDesk',
    authorUrl: 'https://cryptodesk.fr/a-propos/',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article class="container post">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}{pubTime ? ` · ${pubTime} ET` : ''}</time>
        {updatedDate && <span class="updated">· updated {dateFmt.format(updatedDate)}</span>}
        {frHref && (
          <span class="lang-switch">
            · <a href={frHref} hreflang="fr">🇫🇷 Lire en français</a>
          </span>
        )}
      </div>
      <h1 class="post-title">{title}</h1>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((t) => <a class="tag" href={`/en/tags/${t}/`}>#{t}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    {related.length > 0 && (
      <nav class="read-next" aria-label="Read next">
        <p class="read-next-title">📰 Read next</p>
        <div class="read-next-grid">
          {related.map((r) => (
            <a class="read-next-card" href={`/en/posts/${r.slug}/`}>
              <span class="rn-cta">Read article →</span>
              <h3>{r.data.title}</h3>
              <p>{r.data.description}</p>
            </a>
          ))}
        </div>
      </nav>
    )}

    <nav class="post-nav" aria-label="Article navigation">
      {prev && <a class="nav-link prev" href={`/en/posts/${prev.slug}/`}>← {prev.data.title}</a>}
      {next && <a class="nav-link next" href={`/en/posts/${next.slug}/`}>{next.data.title} →</a>}
    </nav>
  </article>

  <style>
    .post { padding-top: 2.5rem; }
    .post-header { margin-bottom: 2.2rem; }
    .post-meta { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem; }
    .lang-switch a { color: var(--accent); text-decoration: none; font-weight: 600; }
    .lang-switch a:hover { text-decoration: underline; }
    .post-title {
      font-size: clamp(1.7rem, 4.5vw, 2.5rem);
      line-height: 1.18;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }
    .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .tag {
      color: var(--accent);
      background: var(--accent-glow);
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s;
    }
    .tag:hover { background: var(--accent-soft); }

    .post-nav {
      display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    }
    .nav-link { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; max-width: 45%; transition: color 0.15s; }
    .nav-link:hover { color: var(--accent); }
    .nav-link.next { text-align: right; }

    /* ── Read next ── */
    .read-next { margin-top: 3rem; }
    .read-next-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--text); }
    .read-next-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .read-next-card {
      display: flex; flex-direction: column-reverse;
      background: var(--card);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.2rem 1.4rem 1.4rem;
      text-decoration: none; color: inherit;
      box-shadow: var(--shadow-sm);
      transition: border-color 0.18s, transform 0.15s, box-shadow 0.15s;
    }
    .read-next-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
    .read-next-card h3 {
      font-size: 1.05rem; font-weight: 700; line-height: 1.3;
      margin-bottom: 0.35rem; color: var(--text);
    }
    .read-next-card p {
      color: var(--text-muted); font-size: 0.88rem; line-height: 1.45;
      flex: 1; margin-bottom: 0.5rem;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .rn-cta {
      color: var(--accent); font-weight: 600; font-size: 0.82rem;
      text-transform: uppercase; letter-spacing: 0.03em;
      margin-top: 0.3rem;
    }

    @media (max-width: 480px) {
      .nav-link { max-width: 100%; }
    }
  </style>
</BaseLayout>
