---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'postsEn'>;
  prev?: CollectionEntry<'postsEn'>;
  next?: CollectionEntry<'postsEn'>;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, ogImage, frSlug } = post.data;

const dateFmt = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
// Publication time (ET) — les analyses US sortent après la clôture des marchés
const timeFmt = new Intl.DateTimeFormat('en-US', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'America/New_York',
});
const pubTime = timeFmt.format(pubDate);
const frHref = frSlug ? `https://cryptodesk.fr/posts/${frSlug}/` : undefined;

// JSON-LD Article
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: 'CryptoDesk', url: 'https://cryptodesk.fr/' },
  publisher: {
    '@type': 'Organization',
    name: 'CryptoDesk',
    logo: { '@type': 'ImageObject', url: 'https://cryptodesk.fr/favicon.svg' },
  },
  mainEntityOfPage: `https://cryptodesk.fr/en/posts/${post.slug}/`,
  inLanguage: 'en-US',
  ...(ogImage ? { image: ogImage } : {}),
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  lang="en"
  alternateHref={frHref}
  article={{
    publishedTime: pubDate.toISOString(),
    ...(updatedDate ? { modifiedTime: updatedDate.toISOString() } : {}),
    tags,
    authorName: 'CryptoDesk',
    authorUrl: 'https://cryptodesk.fr/a-propos/',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <article class="container post">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)} · {pubTime} ET</time>
        {updatedDate && <span class="updated">· updated {dateFmt.format(updatedDate)}</span>}
        {frHref && (
          <span class="lang-switch">
            · <a href={frHref} hreflang="fr">🇫🇷 Lire en français</a>
          </span>
        )}
      </div>
      <h1 class="post-title">{title}</h1>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((t) => <a class="tag" href={`/en/tags/${t}/`}>#{t}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <nav class="post-nav" aria-label="Article navigation">
      {prev && <a class="nav-link prev" href={`/en/posts/${prev.slug}/`}>← {prev.data.title}</a>}
      {next && <a class="nav-link next" href={`/en/posts/${next.slug}/`}>{next.data.title} →</a>}
    </nav>
  </article>

  <style>
    .post { padding-top: 2.5rem; }
    .post-header { margin-bottom: 2.2rem; }
    .post-meta { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 0.75rem; }
    .lang-switch a { color: var(--accent); text-decoration: none; font-weight: 600; }
    .lang-switch a:hover { text-decoration: underline; }
    .post-title {
      font-size: clamp(1.7rem, 4.5vw, 2.5rem);
      line-height: 1.18;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }
    .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .tag {
      color: var(--accent);
      background: var(--accent-glow);
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s;
    }
    .tag:hover { background: var(--accent-soft); }

    .post-nav {
      display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    }
    .nav-link { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; max-width: 45%; transition: color 0.15s; }
    .nav-link:hover { color: var(--accent); }
    .nav-link.next { text-align: right; }

    @media (max-width: 480px) {
      .nav-link { max-width: 100%; }
    }
  </style>
</BaseLayout>
