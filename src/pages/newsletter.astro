---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const editions = (await getCollection('newsletter'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Newsletter — CryptoDesk',
  url: 'https://cryptodesk.fr/newsletter/',
  description: 'Recevez chaque semaine « Le Desk » : les 5 chiffres qui ont bougé, le signal réglementaire, le graphique à retenir et 3 dates à surveiller. Gratuit, sans spam.',
  inLanguage: 'fr-FR',
};
---

<BaseLayout
  title="Newsletter — Le Desk"
  description="« Le Desk » — la newsletter hebdo CryptoDesk : les 5 chiffres qui ont bougé, le signal réglementaire, le graphique à retenir et 3 dates à surveiller. Gratuite et sans spam."
  canonical="https://cryptodesk.fr/newsletter/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="container">
      <h1 class="hero-title">Le Desk — la newsletter hebdo</h1>
      <p class="hero-sub">
        Chaque semaine, l'essentiel qui a <strong>réellement changé</strong> dans la crypto :
        les 5 chiffres qui ont bougé, le signal réglementaire, le graphique à retenir,
        ce que le marché croit (Polymarket) et 3 dates à surveiller.
        <strong>Gratuit, sans spam, désinscription en un clic.</strong>
      </p>
    </div>
  </section>

  <section class="container">
    <div class="newsletter-card">
      <form class="newsletter-form form">
        <label for="nl-email">Votre adresse email</label>
        <div class="form-row">
          <input
            id="nl-email"
            type="email"
            name="email"
            placeholder="vous@exemple.fr"
            autocomplete="email"
            required
          />
          <button type="submit" class="cta">S'abonner</button>
        </div>
        <div class="lang-row" role="radiogroup" aria-label="Langue de la newsletter">
          <label class="lang-pill"><input type="radio" name="lang" value="fr" checked /> 🇫🇷 Français</label>
          <label class="lang-pill"><input type="radio" name="lang" value="en" /> 🇺🇸 English</label>
        </div>
        <label class="consent">
          <input type="checkbox" required />
          J'accepte de recevoir la newsletter CryptoDesk. Désinscription en un clic à tout moment.
        </label>
        <p class="hint">Une édition utile par semaine — pas de spam, promis.</p>
        <p class="newsletter-status" role="status" aria-live="polite"></p>
      </form>

      <div class="promises">
        <div class="promise"><strong>1 édition / semaine</strong><span>5 minutes de lecture</span></div>
        <div class="promise"><strong>Signaux, pas de bruit</strong><span>5 chiffres + 1 graphique + 3 dates</span></div>
        <div class="promise"><strong>Désinscription facile</strong><span>en un clic, à tout moment</span></div>
      </div>
    </div>

    {editions.length > 0 && (
      <div class="archive">
        <h2 class="archive-title">📚 Éditions passées</h2>
        <ul class="archive-list">
          {editions.map((e) => (
            <li>
              <a href={`/newsletter/${e.slug}/`}>
                <span class="archive-lang">{e.data.lang === 'en' ? '🇺🇸 EN' : '🇫🇷 FR'}</span>
                <span class="archive-title-text">{e.data.title}</span>
                <time datetime={e.data.pubDate.toISOString()}>
                  {new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(e.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <script src="/js/newsletter.js" defer></script>

  <style>
    .hero { padding: 3.5rem 0 2.5rem; }
    .hero-title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem; }
    .hero-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 62ch; }
    .hero-sub strong { color: var(--text); }

    .newsletter-card {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 2rem; max-width: 560px; margin-bottom: 3rem;
    }
    .form label { display: block; font-weight: 700; margin-bottom: 0.5rem; }
    .form-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .form input[type="email"] {
      flex: 1; min-width: 220px; padding: 0.7rem 1rem;
      border: 1px solid var(--border); border-radius: 999px; background: var(--bg);
      color: var(--text); font-size: 0.95rem;
    }
    .form input[type="email"]:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .cta {
      background: var(--accent); color: #fff; font-weight: 700; font-size: 0.9rem;
      padding: 0.7rem 1.4rem; border: none; border-radius: 999px; cursor: pointer;
      transition: filter 0.15s, transform 0.15s;
    }
    .cta:hover { filter: brightness(1.1); transform: translateY(-1px); }
    .cta:disabled { opacity: 0.6; cursor: wait; }
    .hint { color: var(--text-muted); font-size: 0.8rem; margin-top: 0.6rem; }
    .lang-row { display: flex; gap: 0.5rem; margin: 0.9rem 0; }
    .lang-pill {
      display: inline-flex; align-items: center; gap: 0.35rem;
      border: 1px solid var(--border); border-radius: 999px; padding: 0.35rem 0.85rem;
      font-size: 0.85rem; cursor: pointer; color: var(--text-muted);
    }
    .lang-pill:has(input:checked) { border-color: var(--accent); color: var(--text); font-weight: 600; }
    .lang-pill input { accent-color: var(--accent); }
    .consent {
      display: flex !important; gap: 0.5rem; align-items: flex-start;
      font-weight: 400 !important; font-size: 0.8rem; color: var(--text-muted); line-height: 1.4;
    }
    .consent input { accent-color: var(--accent); margin-top: 0.15rem; }
    .newsletter-status { min-height: 1.2rem; font-size: 0.88rem; margin-top: 0.5rem; }
    .newsletter-status.ok { color: var(--accent); }
    .newsletter-status.err { color: #f87171; }

    .archive { max-width: 560px; margin-bottom: 3rem; }
    .archive-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 0.9rem; }
    .archive-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
    .archive-list a {
      display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm);
      padding: 0.7rem 1rem; text-decoration: none; color: inherit;
      transition: border-color 0.15s, transform 0.15s;
    }
    .archive-list a:hover { border-color: var(--accent); transform: translateY(-1px); }
    .archive-lang {
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em;
      color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.1rem 0.5rem;
    }
    .archive-title-text { flex: 1; font-weight: 600; font-size: 0.92rem; color: var(--text); }
    .archive-list time { color: var(--text-muted); font-size: 0.8rem; }

    .promises { display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-top: 1.8rem; }
    @media (min-width: 600px) { .promises { grid-template-columns: repeat(3, 1fr); } }
    .promise { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.9rem 1rem; background: var(--bg-alt); border-radius: var(--radius); }
    .promise strong { font-size: 0.88rem; }
    .promise span { color: var(--text-muted); font-size: 0.78rem; }
  </style>
</BaseLayout>
