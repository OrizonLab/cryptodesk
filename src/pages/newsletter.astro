---
import BaseLayout from '../layouts/BaseLayout.astro';

// Identifiant Buttondown — remplacer par le vrai quand le compte est créé.
// Sans identifiant, le formulaire s'affiche en mode "mailto" (copie d'adresse).
const BUTTONDOWN_ID = '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Newsletter — CryptoDesk',
  url: 'https://blog.auratrade.app/newsletter/',
  description: 'Recevez chaque jour les analyses et la crypto du jour de CryptoDesk par email. Gratuit, sans spam.',
  inLanguage: 'fr-FR',
};
---

<BaseLayout
  title="Newsletter"
  description="La newsletter CryptoDesk : chaque jour, l'essentiel de la crypto — analyse, crypto du jour, marchés de prédiction. Gratuite et sans spam."
  canonical="https://blog.auratrade.app/newsletter/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="container">
      <h1 class="hero-title">Newsletter CryptoDesk</h1>
      <p class="hero-sub">
        Chaque jour, l'essentiel de la crypto dans votre boîte mail : l'analyse du jour,
        la <strong>crypto du moment</strong> avec ses niveaux, et les mouvements des
        marchés de prédiction. <strong>Gratuit, sans spam.</strong>
      </p>
    </div>
  </section>

  <section class="container">
    <div class="newsletter-card">
      {
        BUTTONDOWN_ID ? (
          <form
            class="form"
            action={`https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_ID}`}
            method="post"
            target="popupwindow"
          >
            <input type="hidden" name="embed" value="1" />
            <label for="email">Votre adresse email</label>
            <div class="form-row">
              <input
                id="email"
                type="email"
                name="email"
                placeholder="vous@exemple.fr"
                required
              />
              <button type="submit" class="cta">S'abonner</button>
            </div>
            <p class="hint">Une fois par jour, désinscription en un clic.</p>
          </form>
        ) : (
          <div class="form">
            <p class="fallback">
              📬 La newsletter arrive bientôt. En attendant, suivez-nous sur
              <a href="https://bsky.app/profile/crypto-desk.bsky.social" target="_blank" rel="noopener"> Bluesky</a>
              ou via le <a href="/rss.xml">flux RSS</a>.
            </p>
          </div>
        )
      }

      <div class="promises">
        <div class="promise"><strong>1 email / jour</strong><span>pas de spam, promis</span></div>
        <div class="promise"><strong>Analyse + crypto du jour</strong><span>l'essentiel en 5 min</span></div>
        <div class="promise"><strong>Désinscription facile</strong><span>en un clic, à tout moment</span></div>
      </div>
    </div>
  </section>

  <style>
    .hero { padding: 3.5rem 0 2.5rem; }
    .hero-title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem; }
    .hero-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 60ch; }
    .hero-sub strong { color: var(--text); }

    .newsletter-card {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 2rem; max-width: 560px; margin-bottom: 3rem;
    }
    .form label { display: block; font-weight: 700; margin-bottom: 0.5rem; }
    .form-row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
    .form input[type="email"] {
      flex: 1; min-width: 220px; padding: 0.7rem 1rem;
      border: 1px solid var(--border); border-radius: 999px; background: var(--bg);
      color: var(--text); font-size: 0.95rem;
    }
    .form input[type="email"]:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .cta {
      background: var(--accent); color: #fff; font-weight: 700; font-size: 0.9rem;
      padding: 0.7rem 1.4rem; border: none; border-radius: 999px; cursor: pointer;
      transition: filter 0.15s, transform 0.15s;
    }
    .cta:hover { filter: brightness(1.1); transform: translateY(-1px); }
    .hint { color: var(--text-muted); font-size: 0.8rem; margin-top: 0.6rem; }
    .fallback { color: var(--text-muted); }
    .fallback a { color: var(--accent); }

    .promises { display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-top: 1.8rem; }
    @media (min-width: 600px) { .promises { grid-template-columns: repeat(3, 1fr); } }
    .promise { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.9rem 1rem; background: var(--bg-alt); border-radius: var(--radius); }
    .promise strong { font-size: 0.88rem; }
    .promise span { color: var(--text-muted); font-size: 0.78rem; }
  </style>
</BaseLayout>
