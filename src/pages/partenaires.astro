---
import BaseLayout from '../layouts/BaseLayout.astro';
import { activeAffiliates, featuredOffers, riskWarning, micaNotice } from '../data/affiliates';

const partners = activeAffiliates;
const offers = featuredOffers;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Partenaires & exchanges — CryptoDesk',
  url: 'https://cryptodesk.fr/partenaires/',
  description: 'Les exchanges crypto agréés MiCA que CryptoDesk recommande : Bitvavo, Bitstack, OKX, Kraken Pro.',
  inLanguage: 'fr-FR',
};
---

<BaseLayout
  title="Partenaires — exchanges agréés MiCA"
  description="Les exchanges crypto agréés MiCA recommandés par CryptoDesk : Bitvavo, Bitstack, OKX, Kraken Pro. Agréments vérifiés sur le registre ESMA. Liens d'affiliation — sans surcoût pour toi."
  canonical="https://cryptodesk.fr/partenaires/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="container">
      <h1 class="hero-title">Exchanges & partenaires</h1>
      <p class="hero-sub">
        Les plateformes que nous utilisons et recommandons — <strong>toutes agréées MiCA</strong>
        et vérifiées sur le registre officiel de l'ESMA. En passant par ces liens,
        <strong>tu ne paies pas plus cher</strong> et tu soutiens le blog.
      </p>
      <p class="hero-link">
        Besoin de trancher entre elles ? Le <a href="/comparateur/">comparateur d'exchanges</a>
        met les frais, la régulation et le profil idéal côte à côte, et estime le coût réel d'un achat.
      </p>
    </div>
  </section>

  <section class="container">
    <div class="risk-banner" role="note">
      <p class="risk-title">⚠️ Avertissement sur les risques</p>
      <p class="risk-text">{riskWarning}</p>
      <p class="risk-text risk-mica">✅ {micaNotice}</p>
    </div>
  </section>

  {offers.length > 0 && (
    <section class="container">
      <div class="offers">
        <h2 class="offers-title">🔥 Offres du moment</h2>
        <p class="offers-sub">Les promotions de parrainage actives en ce moment — mises à jour automatiquement.</p>
        <div class="offers-grid">
          {offers.map((p) => (
            <a class="offer-card" href={p.url} target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate={p.umami}>
              <span class="offer-name">{p.name}</span>
              <span class="offer-promo">{p.promo}</span>
              <span class="offer-cta">{p.cta} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="container">
    <div class="grid">
      {
        partners.map((p) => (
          <div class="card">
            <div class="card-head">
              <h2>{p.name}</h2>
              <span class="pill">Partenaire</span>
            </div>
            <p class="tagline">{p.tagline}</p>
            <p class="bonus">{p.bonus}</p>
            <a class="cta" href={p.url} target="_blank" rel="noopener sponsored nofollow" data-umami-event="affiliate-click" data-umami-event-affiliate={p.name.toLowerCase()}>
              {p.cta} →
            </a>
            <p class="note">{p.note}</p>
            {p.mica && <p class="mica">✅ Agréé MiCA — {p.mica}</p>}
            <p class="card-risk">⚠️ Risque : perte totale du capital possible, volatilité extrême, risque de piratage. Aucune protection des dépôts — contrairement à un compte bancaire.</p>
          </div>
        ))
      }
    </div>

    <div class="disclaimer">
      <h3>Transparence & conformité</h3>
      <p>
        CryptoDesk perçoit une commission si tu ouvres un compte via ces liens d'affiliation.
        Cela ne change <strong>rien à ton tarif</strong> : les frais sont les mêmes que tu
        passes par ici ou par le site officiel. Ces revenus financent la rédaction du blog.
      </p>
      <p>
        Conformément au règlement MiCA (applicable depuis le 1<sup>er</sup> juillet 2026), nous ne
        promouvons que des prestataires de services sur crypto-actifs <strong>agréés</strong>.
        Chaque agrément est vérifié sur le registre public de l'ESMA avant publication, et revérifié
        régulièrement. Deux partenaires qui ne figuraient pas dans ce registre (WEEX et Bitget) ont
        été <strong>retirés du site le 18 septembre 2026</strong>, avant l'entrée en vigueur de toute
        sanction.
      </p>
      <p class="small">
        ⚠️ Les plateformes citées sont des tiers : leurs conditions, leurs frais et leurs risques
        évoluent — vérifie-les sur leur site avant de t'inscrire. Rien sur ce site n'est un conseil
        en investissement ni une recommandation personnalisée.
      </p>
    </div>
  </section>

  <style>
    .hero { padding: 3.5rem 0 2.5rem; }
    .hero-title {
      font-size: clamp(1.9rem, 4.5vw, 2.8rem);
      line-height: 1.15;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }
    .hero-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 60ch; }
    .hero-sub strong { color: var(--text); }

    /* Avertissement risque — même niveau visuel que les offres (exigence MiCA/ARPP) */
    .risk-banner {
      background: var(--bg-alt);
      border: 1px solid var(--accent);
      border-left: 4px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.1rem 1.3rem;
      margin-bottom: 2rem;
    }
    .risk-title { font-weight: 800; font-size: 1rem; margin-bottom: 0.5rem; color: var(--text); }
    .risk-text { color: var(--text); font-size: 0.95rem; line-height: 1.55; }
    .risk-text + .risk-text { margin-top: 0.6rem; }
    .risk-mica { color: var(--text-muted); }

    .grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-bottom: 2.5rem; }
    @media (min-width: 640px) {
      .grid { grid-template-columns: 1fr 1fr; }
    }

    .offers { margin-bottom: 2.5rem; }
    .offers-title { font-size: 1.35rem; font-weight: 800; margin-bottom: 0.3rem; }
    .offers-sub { color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1rem; }
    .offers-grid { display: grid; grid-template-columns: 1fr; gap: 0.9rem; }
    @media (min-width: 640px) {
      .offers-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
    }
    .offer-card {
      display: flex; flex-direction: column; gap: 0.4rem;
      background: var(--card);
      border: 1px solid var(--accent);
      border-radius: var(--radius);
      padding: 1.1rem 1.3rem;
      text-decoration: none; color: inherit;
      box-shadow: var(--shadow-sm);
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .offer-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .offer-name { font-weight: 800; font-size: 1.05rem; color: var(--text); }
    .offer-promo { color: var(--text-muted); font-size: 0.9rem; flex: 1; }
    .offer-cta { color: var(--accent); font-weight: 700; font-size: 0.85rem; }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .card-head { display: flex; align-items: center; justify-content: space-between; }
    .card h2 { font-size: 1.3rem; font-weight: 800; }
    .pill {
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.15rem 0.6rem;
    }
    .tagline { color: var(--text); font-weight: 600; }
    .bonus { color: var(--text-muted); font-size: 0.95rem; }
    .cta {
      display: inline-block; margin-top: 0.5rem; align-self: flex-start;
      background: var(--accent); color: #fff; font-weight: 700; font-size: 0.9rem;
      padding: 0.55rem 1.1rem; border-radius: 999px; text-decoration: none;
      transition: filter 0.15s, transform 0.15s;
    }
    .cta:hover { filter: brightness(1.1); transform: translateY(-1px); }
    .note { color: var(--text-muted); font-size: 0.8rem; opacity: 0.85; }

    /* Agrément MiCA vérifié (registre ESMA) */
    .mica {
      font-size: 0.82rem; line-height: 1.45;
      color: var(--text-muted);
      background: var(--bg-alt);
      border-radius: calc(var(--radius) / 2);
      padding: 0.5rem 0.7rem;
      margin-top: 0.35rem;
    }

    /* Rappel de risque accolé à CHAQUE bloc d'affiliation — lisible, pas en footer */
    .card-risk {
      font-size: 0.86rem; line-height: 1.45; font-weight: 600;
      color: var(--text);
      background: var(--bg-alt);
      border-left: 3px solid var(--accent);
      border-radius: calc(var(--radius) / 2);
      padding: 0.55rem 0.75rem;
      margin-top: 0.35rem;
    }

    .disclaimer {
      background: var(--bg-alt); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.5rem; margin-bottom: 2rem;
    }
    .disclaimer h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
    .disclaimer p { color: var(--text-muted); font-size: 0.92rem; }
    .disclaimer .small { font-size: 0.82rem; margin-top: 0.75rem; opacity: 0.85; }
  </style>
</BaseLayout>
