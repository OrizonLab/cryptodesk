---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Article précédent / suivant par date
const all = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const idx = all.findIndex((p) => p.slug === post.slug);
const next = idx > 0 ? all[idx - 1] : undefined;
const prev = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;

// Articles liés : même tag que l'article courant, hors lui-même, max 2
const related = all
  .filter(p => p.slug !== post.slug)
  .filter(p => (p.data.tags ?? []).some((t: string) => (post.data.tags ?? []).includes(t)))
  .slice(0, 2);
// Si pas assez de liés par tags, compléter avec les articles récents
const moreNeeded = 2 - related.length;
if (moreNeeded > 0) {
  const recent = all
    .filter(p => p.slug !== post.slug && !related.some(r => r.slug === p.slug))
    .slice(0, moreNeeded);
  related.push(...recent);
}
---

<PostLayout post={post} prev={prev} next={next} related={related}>
  <Content />
</PostLayout>
