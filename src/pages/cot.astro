---
import { readFile } from 'node:fs/promises';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Observation {
  report_date: string;
  open_interest_all: number | null;
  lev_money_positions_long: number | null;
  lev_money_positions_short: number | null;
  [key: string]: string | number | null;
}
interface CotSeries {
  contract_market_code: string;
  market_name: string;
  asset: string;
  label: string;
  venue: string;
  contract_kind: string;
  core: boolean;
  observations: Observation[];
}
interface CotArchive {
  generated_at_utc: string;
  latest_report_date: string | null;
  last_collected_at_utc: string | null;
  coverage: { observation_count: number; report_date_count: number; first_report_date: string | null; last_report_date: string | null };
  series: CotSeries[];
}

let archive: CotArchive | null = null;
try {
  const raw = await readFile(new URL('../../public/cot-history.json', import.meta.url), 'utf8');
  archive = JSON.parse(raw) as CotArchive;
} catch {
  // Page build remains possible before the first local archive export.
}

const allSeries = archive?.series ?? [];
const coreSeries = allSeries.filter((s) => s.core);
const initialSeries = coreSeries.find((s) => s.contract_market_code === '133741') ?? coreSeries[0] ?? allSeries[0] ?? null;
const initialObservations = initialSeries?.observations.slice(-52) ?? [];
const latest = initialSeries?.observations.at(-1) ?? null;

const categories = [
  { id: 'lev_money', label: 'Fonds à effet de levier', long: 'lev_money_positions_long', short: 'lev_money_positions_short' },
  { id: 'asset_mgr', label: 'Gestionnaires d’actifs', long: 'asset_mgr_positions_long', short: 'asset_mgr_positions_short' },
  { id: 'dealer', label: 'Intermédiaires / dealers', long: 'dealer_positions_long_all', short: 'dealer_positions_short_all' },
  { id: 'other_rept', label: 'Autres grands déclarants', long: 'other_rept_positions_long', short: 'other_rept_positions_short' },
  { id: 'nonrept', label: 'Non-déclarants', long: 'nonrept_positions_long_all', short: 'nonrept_positions_short_all' },
];
const fmt = (value: number | null | undefined) => value == null ? '—' : Math.round(value).toLocaleString('fr-FR');
const positionPct = (obs: Observation | null, longField: string, shortField: string) => {
  if (!obs || obs.open_interest_all == null || obs.open_interest_all <= 0) return null;
  const long = obs[longField];
  const short = obs[shortField];
  if (typeof long !== 'number' || typeof short !== 'number') return null;
  return ((long - short) / obs.open_interest_all) * 100;
};
const initialCategory = categories[0];
const initialNetPct = positionPct(latest, initialCategory.long, initialCategory.short);
const chartWidth = 900;
const chartHeight = 290;
const pad = { left: 58, right: 18, top: 18, bottom: 38 };
const initialPoints = initialObservations.flatMap((obs) => {
  const value = positionPct(obs, initialCategory.long, initialCategory.short);
  return value == null ? [] : [{ date: obs.report_date, value }];
});
const bound = Math.max(10, ...initialPoints.map((p) => Math.abs(p.value)));
const xAt = (i: number) => pad.left + (initialPoints.length <= 1 ? 0 : i * (chartWidth - pad.left - pad.right) / (initialPoints.length - 1));
const yAt = (value: number) => pad.top + (bound - value) * (chartHeight - pad.top - pad.bottom) / (2 * bound);
const initialPath = initialPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${xAt(i).toFixed(1)} ${yAt(p.value).toFixed(1)}`).join(' ');
const zeroY = yAt(0);
const firstDate = initialPoints[0]?.date ?? null;
const lastDate = initialPoints.at(-1)?.date ?? null;
const latestLong = latest?.[initialCategory.long];
const latestShort = latest?.[initialCategory.short];
const latestOi = latest?.open_interest_all;
const latestDeltaLong = latest?.change_in_lev_money_long;
const latestDeltaShort = latest?.change_in_lev_money_short;
const latestNetChange = typeof latestDeltaLong === 'number' && typeof latestDeltaShort === 'number' ? latestDeltaLong - latestDeltaShort : null;
---

<BaseLayout
  title="Rapport COT — positions des traders sur les futures crypto"
  description="Visualisez l’évolution des positions déclarées sur les contrats futures Bitcoin et Ether, avec une explication simple du rapport COT de la CFTC."
  canonical="https://cryptodesk.fr/cot"
>
  <section class="cot-hero">
    <div class="container-wide">
      <p class="cot-kicker">Données publiques · CFTC</p>
      <h1>Que font les grands traders sur les futures crypto&nbsp;?</h1>
      <p class="cot-lead">Le rapport COT photographie les positions des traders sur les marchés à terme. Il aide à suivre leur évolution — mais il ne dit pas, à lui seul, où ira le prix.</p>
      <div class="cot-stamp">
        <span><strong>Positions au</strong> {archive?.latest_report_date ?? '—'}</span>
        <span><strong>Archive</strong> {archive?.coverage.observation_count.toLocaleString('fr-FR') ?? '0'} observations</span>
        <span><strong>Collecte</strong> {archive?.last_collected_at_utc ?? '—'}</span>
      </div>
    </div>
  </section>

  <section class="container-wide cot-content">
    {!archive || allSeries.length === 0 ? (
      <div class="cot-panel"><h2>Historique en préparation</h2><p>L’archive CFTC sera affichée après sa première collecte et son export statique.</p></div>
    ) : (
      <>
        <div class="cot-panel cot-chart-panel" id="cot-explorer" data-json-url="/cot-history.json">
          <div class="cot-panel-heading">
            <div>
              <p class="cot-eyebrow">Positionnement hebdomadaire</p>
              <h2 id="cot-chart-title">{initialSeries?.label ?? 'Bitcoin · CME'}</h2>
              <p class="cot-muted">Position nette des <span id="cot-category-label">Fonds à effet de levier</span>, en % de l’intérêt ouvert</p>
            </div>
            <a class="cot-download" href="/cot-history.json" download>Télécharger les données</a>
          </div>

          <div class="cot-controls" aria-label="Filtres du graphique">
            <label>Contrat
              <select id="cot-market" name="market">
                {allSeries.map((series) => <option value={`${series.contract_market_code}|${series.market_name}`} selected={series === initialSeries}>{series.label}{series.core ? ' · principal' : ' · complémentaire'}</option>)}
              </select>
            </label>
            <label>Catégorie
              <select id="cot-category" name="category">
                {categories.map((category) => <option value={category.id}>{category.label}</option>)}
              </select>
            </label>
            <label>Période
              <select id="cot-range" name="range">
                <option value="52">52 derniers rapports</option>
                <option value="260">Jusqu’à 5 ans</option>
                <option value="all">Toute la période disponible</option>
              </select>
            </label>
          </div>

          <div class="cot-chart-wrap" role="img" aria-label="Graphique de la position nette des fonds à effet de levier en pourcentage de l’intérêt ouvert">
            <svg id="cot-chart" viewBox={`0 0 ${chartWidth} ${chartHeight}`} aria-hidden="true" focusable="false">
              <line x1={pad.left} x2={chartWidth - pad.right} y1={pad.top} y2={pad.top} class="cot-gridline" />
              <line x1={pad.left} x2={chartWidth - pad.right} y1={yAt(bound / 2)} y2={yAt(bound / 2)} class="cot-gridline" />
              <line x1={pad.left} x2={chartWidth - pad.right} y1={zeroY} y2={zeroY} class="cot-zero" />
              <line x1={pad.left} x2={chartWidth - pad.right} y1={yAt(-bound / 2)} y2={yAt(-bound / 2)} class="cot-gridline" />
              <line x1={pad.left} x2={chartWidth - pad.right} y1={yAt(-bound)} y2={yAt(-bound)} class="cot-gridline" />
              <text x="8" y={pad.top + 4} class="cot-axis-label">+{bound.toFixed(0)}%</text>
              <text x="8" y={yAt(bound / 2) + 4} class="cot-axis-label">+{(bound / 2).toFixed(0)}%</text>
              <text x="20" y={zeroY + 4} class="cot-axis-label">0%</text>
              <text x="8" y={yAt(-bound / 2) + 4} class="cot-axis-label">−{(bound / 2).toFixed(0)}%</text>
              <text x="8" y={yAt(-bound) + 4} class="cot-axis-label">−{bound.toFixed(0)}%</text>
              <path id="cot-line" d={initialPath} class="cot-line" />
              <g id="cot-points">
                {initialPoints.map((point, index) => (
                  <circle cx={xAt(index)} cy={yAt(point.value)} r={index === initialPoints.length - 1 ? 4.5 : 2.5} class="cot-point">
                    <title>{point.date} · net {point.value.toFixed(2)} % de l’intérêt ouvert</title>
                  </circle>
                ))}
              </g>
              <text id="cot-date-start" x={pad.left} y={chartHeight - 8} class="cot-axis-label">{firstDate ?? ''}</text>
              <text id="cot-date-end" x={chartWidth - pad.right} y={chartHeight - 8} text-anchor="end" class="cot-axis-label">{lastDate ?? ''}</text>
            </svg>
          </div>
          <p id="cot-no-data" class="cot-no-data" hidden>Pas de données disponibles pour cette sélection.</p>

          <div class="cot-kpis" aria-live="polite">
            <div><span>Position nette</span><strong id="cot-net">{fmt(typeof latestLong === 'number' && typeof latestShort === 'number' ? latestLong - latestShort : null)}</strong><small id="cot-net-pct">{initialNetPct == null ? '—' : `${initialNetPct.toFixed(1)} % de l’intérêt ouvert`}</small></div>
            <div><span>Positions longues / courtes</span><strong id="cot-ls">{fmt(typeof latestLong === 'number' ? latestLong : null)} / {fmt(typeof latestShort === 'number' ? latestShort : null)}</strong><small>contrats déclarés</small></div>
            <div><span>Intérêt ouvert</span><strong id="cot-oi">{fmt(typeof latestOi === 'number' ? latestOi : null)}</strong><small>contrats ouverts, toutes catégories</small></div>
            <div><span>Variation nette hebdomadaire</span><strong id="cot-change">{fmt(latestNetChange)}</strong><small>longs ajoutés − shorts ajoutés</small></div>
          </div>
          <p class="cot-range-note">Période affichée : <span id="cot-range-label">52 derniers rapports disponibles</span>. Dernier rapport de cette série : <span id="cot-last-series-date">{latest?.report_date ?? '—'}</span>. Une position nette positive signifie que cette catégorie détient davantage de contrats longs que de contrats courts, après compensation.</p>
        </div>

        <div class="cot-grid-2">
          <article class="cot-panel">
            <p class="cot-eyebrow">Comprendre en 30 secondes</p>
            <h2>Un thermomètre de positionnement, pas une boule de cristal</h2>
            <p>Chaque semaine, la CFTC publie un état des positions sur les futures. Les données portent généralement sur les positions du mardi précédent et sont publiées le vendredi ; les jours fériés peuvent décaler ce calendrier.[<a href="https://www.cftc.gov/MarketReports/CommitmentsofTraders/ReleaseSchedule/index.htm" target="_blank" rel="noopener">source CFTC</a>]</p>
            <p>Le graphique montre la différence entre contrats longs et courts, rapportée à l’intérêt ouvert. Cela aide à comparer le poids du positionnement dans le temps, sans additionner les contrats de tailles différentes.</p>
            <p><strong>À retenir :</strong> les positions peuvent refléter couverture, arbitrage ou spéculation. Une hausse des positions nettes ne garantit pas une hausse du prix, et ces rapports arrivent avec retard.</p>
          </article>
          <article class="cot-panel">
            <p class="cot-eyebrow">Qui est qui&nbsp;?</p>
            <h2>Les catégories du rapport TFF</h2>
            <ul class="cot-definitions">
              <li><strong>Fonds à effet de levier :</strong> fonds et gestionnaires pouvant prendre des positions directionnelles ou d’arbitrage.</li>
              <li><strong>Gestionnaires d’actifs :</strong> investisseurs institutionnels, fonds et gestionnaires de portefeuille.</li>
              <li><strong>Dealers / intermédiaires :</strong> acteurs qui facilitent les transactions et peuvent couvrir des risques de clients ; leur position n’est pas un pari directionnel simple.</li>
              <li><strong>Autres grands déclarants :</strong> autres participants dépassant le seuil de déclaration.</li>
              <li><strong>Non-déclarants :</strong> positions sous les seuils de déclaration de la CFTC.</li>
            </ul>
            <p class="cot-small">Ces groupes sont des classifications de participants, pas une lecture des intentions de chaque trader. <a href="https://www.cftc.gov/sites/default/files/idc/groups/public/@commitmentsoftraders/documents/file/tfmexplanatorynotes.pdf" target="_blank" rel="noopener">Notes explicatives de la CFTC</a>.</p>
          </article>
        </div>

        <div class="cot-panel cot-method">
          <h2>Comment lire les niveaux</h2>
          <div class="cot-method-grid">
            <div><b>Au-dessus de zéro</b><p>Les longs dépassent les shorts dans la catégorie sélectionnée.</p></div>
            <div><b>En dessous de zéro</b><p>Les shorts dépassent les longs. Ce n’est pas automatiquement un signal baissier.</p></div>
            <div><b>La ligne bouge vite</b><p>Le positionnement évolue ; vérifie aussi l’intérêt ouvert et les changements de la semaine.</p></div>
          </div>
          <p class="cot-source">Jeu utilisé : <a href="https://publicreporting.cftc.gov/Commitments-of-Traders/TFF-Futures-Only/gpe5-46if/about_data" target="_blank" rel="noopener">CFTC · Traders in Financial Futures · Futures Only</a>. Les séries de contrats différents sont affichées séparément ; les contrats Nano/perp-style et historiques ne sont pas fusionnés avec ceux du CME.</p>
          <p class="cot-disclaimer">Information pédagogique uniquement — données retardées, classifications agrégées, aucune recommandation d’achat ou de vente.</p>
        </div>
      </>
    )}
  </section>

  <script src="/js/cot-explorer.js" is:inline defer></script>

  <style>
    .cot-hero { padding: 3.5rem 0 2.2rem; background: linear-gradient(135deg, var(--card) 25%, var(--accent-glow)); border-bottom: 1px solid var(--border); }
    .cot-kicker, .cot-eyebrow { color: var(--accent); text-transform: uppercase; letter-spacing: .08em; font-size: .76rem; font-weight: 800; margin-bottom: .55rem; }
    .cot-hero h1 { max-width: 22ch; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.08; letter-spacing: -.035em; margin-bottom: 1rem; }
    .cot-lead { max-width: 68ch; color: var(--text-muted); font-size: 1.08rem; }
    .cot-stamp { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 1.5rem; }
    .cot-stamp span { border: 1px solid var(--border); background: var(--card); border-radius: 999px; padding: .35rem .75rem; font-size: .78rem; color: var(--text-muted); }
    .cot-stamp strong { color: var(--text); }
    .cot-content { padding-top: 2rem; }
    .cot-panel { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: clamp(1rem, 2.5vw, 1.6rem); margin-bottom: 1.2rem; box-shadow: var(--shadow-sm); }
    .cot-panel h2 { font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.3; margin-bottom: .55rem; }
    .cot-panel p { color: var(--text-muted); margin: .65rem 0; }
    .cot-panel a { color: var(--accent-strong); text-underline-offset: 2px; }
    .cot-panel-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .cot-muted { color: var(--text-muted); font-size: .9rem; }
    .cot-download { font-size: .82rem; border: 1px solid var(--border); border-radius: 999px; padding: .4rem .75rem; text-decoration: none; white-space: nowrap; }
    .cot-controls { display: grid; grid-template-columns: 2fr 1.4fr 1.4fr; gap: .8rem; margin: 1.1rem 0 .5rem; }
    .cot-controls label { color: var(--text-muted); font-size: .78rem; font-weight: 700; display: flex; flex-direction: column; gap: .3rem; }
    .cot-controls select { width: 100%; min-height: 42px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg); color: var(--text); padding: .55rem .65rem; font: inherit; font-size: .86rem; }
    .cot-chart-wrap { width: 100%; overflow-x: auto; margin-top: .4rem; }
    #cot-chart { width: 100%; min-width: 540px; height: auto; overflow: visible; }
    .cot-gridline { stroke: var(--border); stroke-width: 1; }
    .cot-zero { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 5; opacity: .75; }
    .cot-axis-label { fill: var(--text-muted); font-size: 11px; font-family: inherit; }
    .cot-line { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
    .cot-point { fill: var(--accent); stroke: var(--card); stroke-width: 1.2; }
    .cot-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; margin: .6rem 0; }
    .cot-kpis > div { display: flex; flex-direction: column; gap: .22rem; background: var(--bg-alt); border-radius: 10px; padding: .8rem; min-width: 0; }
    .cot-kpis span { color: var(--text-muted); font-size: .73rem; }
    .cot-kpis strong { font-size: clamp(.9rem, 1.8vw, 1.18rem); overflow-wrap: anywhere; }
    .cot-kpis small { color: var(--text-muted); font-size: .7rem; }
    .cot-range-note, .cot-small, .cot-source, .cot-disclaimer { font-size: .79rem; }
    .cot-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
    .cot-grid-2 .cot-panel { margin-bottom: 1.2rem; }
    .cot-definitions { padding-left: 1.15rem; color: var(--text-muted); }
    .cot-definitions li { padding: .25rem 0; }
    .cot-definitions strong { color: var(--text); }
    .cot-method-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
    .cot-method-grid > div { background: var(--bg-alt); padding: .8rem; border-radius: 10px; }
    .cot-method-grid b { font-size: .86rem; }
    .cot-method-grid p { font-size: .82rem; margin-bottom: 0; }
    .cot-disclaimer { border-top: 1px solid var(--border); padding-top: .8rem; }
    .cot-no-data { color: var(--text-muted); padding: 1rem; }
    @media (max-width: 760px) {
      .cot-controls { grid-template-columns: 1fr; }
      .cot-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .cot-grid-2 { grid-template-columns: 1fr; gap: 0; }
      .cot-method-grid { grid-template-columns: 1fr; }
      .cot-panel-heading { flex-direction: column; }
      .cot-stamp { flex-direction: column; align-items: flex-start; }
    }
  </style>
</BaseLayout>
