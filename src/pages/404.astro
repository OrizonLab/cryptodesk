---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="La page demandée n'existe pas.">
  <section class="container notfound">
    <h1>404</h1>
    <p>Cette page n'existe pas ou a été déplacée.</p>
    <a class="home" href="/">← Retour à l'accueil</a>
  </section>
  <style>
    .notfound { padding: 5rem 0; text-align: center; }
    .notfound h1 { font-size: 4rem; font-weight: 800; color: var(--accent); }
    .notfound p { color: var(--text-muted); margin: 0.5rem 0 1.5rem; }
    .home { color: var(--accent); text-decoration: none; font-weight: 600; }
  </style>
</BaseLayout>
