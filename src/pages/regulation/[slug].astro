---
import BaseLayout from '../../layouts/BaseLayout.astro';
import dossiersData from '../../data/regulation-dossiers.json';

export async function getStaticPaths() {
  return dossiersData.dossiers.map((d) => ({
    params: { slug: d.slug },
    props: { d },
  }));
}

const { d } = Astro.props;

const levelLabel: Record<string, { label: string; css: string }> = {
  active: { label: 'En application', css: 'lv-active' },
  paused: { label: 'En pause', css: 'lv-paused' },
  monitoring: { label: 'Suivi en cours', css: 'lv-monitor' },
};
const lv = levelLabel[d.statusLevel] ?? levelLabel.monitoring;

const fmtDate = (x: string) => {
  const m = x.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  return m ? `${m[3]}/${m[2]}/${m[1]}` : x;
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${d.name} — Regulation Clock`,
  url: `https://cryptodesk.fr/regulation/${d.slug}/`,
  description: d.status,
  inLanguage: 'fr-FR',
};
---

<BaseLayout title={`${d.name} — Regulation Clock`} description={d.status}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="container">
    <p class="back"><a href="/regulation/">← Regulation Clock</a></p>

    <div class="head">
      <span class="dossier-emoji">{d.emoji}</span>
      <h1 class="title">{d.name}</h1>
      <span class={`lv ${lv.css}`}>{lv.label}</span>
      <p class="scope">{d.scope}</p>
      <p class="status">{d.status}</p>
    </div>

    <div class="cols">
      <div class="col-main">
        <div class="card">
          <h2>📌 Dernière action officielle</h2>
          <p class="card-date">{fmtDate(d.lastAction.date)}</p>
          <p class="card-text">{d.lastAction.text}</p>
        </div>

        <div class="card">
          <h2>⏭️ Prochaine étape</h2>
          <p class="card-date">{d.nextStep.date}</p>
          <p class="card-text">{d.nextStep.text}</p>
        </div>

        <div class="card impact">
          <h2>💡 Ce que ça change concrètement</h2>
          <p>{d.whatChanges}</p>
        </div>

        <div class="card">
          <h2>🗓️ Chronologie</h2>
          {
            d.timeline.length > 0 ? (
              <ul class="timeline">
                {d.timeline.map((t) => (
                  <li><span class="tl-date">{fmtDate(t.date)}</span><span>{t.event}</span></li>
                ))}
              </ul>
            ) : (
              <p class="muted">Chronologie en cours de constitution par le moniteur.</p>
            )
          }
        </div>

        <div class="card">
          <h2>📜 Sources primaires</h2>
          <ul class="sources">
            {d.sources.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.label} ↗</a></li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="col-side">
        {
          d.polymarket ? (
            <div class="pm">
              <h3>📊 Ce que le marché croit</h3>
              <p class="pm-title">{d.polymarket.title}</p>
              <p class="pm-proba">{d.polymarket.proba} %</p>
              <a class="pm-link" href={d.polymarket.url} target="_blank" rel="noopener nofollow">
                Voir le marché → <span class="pm-disc">(Polymarket — indicatif)</span>
              </a>
            </div>
          ) : (
            <div class="pm pm-empty">
              <h3>📊 Ce que le marché croit</h3>
              <p>Aucun marché Polymarket dédié identifié pour ce dossier.</p>
            </div>
          )
        }

          <div class="follow">
            <h3>Suivre ce dossier</h3>
            <p>
              Le moniteur signale chaque nouvelle action officielle :
            </p>
            <a class="btn btn-primary" href="/regulation/rss.xml">Flux RSS réglementaire</a>
            <a class="btn btn-ghost" href="/newsletter/">La newsletter Le Desk</a>
          </div>

          <div class="method-side">
            <h3>Méthode</h3>
            <p>
              Statut fondé uniquement sur des documents officiels (Congress.gov, Federal Register,
              EUR-Lex). Proba Polymarket indicative — pas une prédiction de CryptoDesk.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <style>
      .back { margin: 1.5rem 0 0.5rem; }
      .back a { color: var(--accent); text-decoration: none; font-size: 0.9rem; }
      .back a:hover { text-decoration: underline; }
      .head { padding: 1rem 0 1.5rem; display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
      .dossier-emoji { font-size: 2rem; }
      .title { font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; }
      .lv { font-size: 0.72rem; font-weight: 700; padding: 0.28rem 0.65rem; border-radius: 999px; }
      .lv-active { background: var(--accent-glow); color: var(--accent); border: 1px solid var(--accent); }
      .lv-paused { background: #fef3c7; color: #b45309; border: 1px solid #f59e0b; }
      [data-theme="dark"] .lv-paused { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
      .lv-monitor { background: var(--bg-alt); color: var(--text-muted); border: 1px solid var(--border); }
      .scope { width: 100%; color: var(--text-muted); font-size: 0.85rem; }
      .status { width: 100%; font-weight: 600; font-size: 1.05rem; }

      .cols { display: grid; grid-template-columns: 1fr; gap: 1.2rem; margin-bottom: 3rem; }
      @media (min-width: 820px) { .cols { grid-template-columns: 1fr 300px; align-items: start; } }

      .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.3rem 1.5rem; margin-bottom: 1.1rem; }
      .card h2 { font-size: 1.05rem; font-weight: 800; margin-bottom: 0.4rem; }
      .card-date { color: var(--accent); font-weight: 700; font-size: 0.85rem; margin-bottom: 0.3rem; }
      .card-text { color: var(--text); font-size: 0.95rem; line-height: 1.55; }
      .impact { background: linear-gradient(135deg, var(--card) 60%, var(--accent-glow)); }
      .timeline { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
      .timeline li { display: flex; gap: 0.9rem; font-size: 0.9rem; line-height: 1.45; }
      .tl-date { color: var(--accent); font-weight: 700; white-space: nowrap; font-size: 0.82rem; padding-top: 0.1rem; }
      .sources { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
      .sources a { color: var(--accent); text-decoration: none; font-size: 0.9rem; }
      .sources a:hover { text-decoration: underline; }
      .muted { color: var(--text-muted); font-size: 0.88rem; }

      .pm { background: var(--card); border: 1px solid var(--accent); border-radius: var(--radius); padding: 1.2rem 1.3rem; margin-bottom: 1.1rem; }
      .pm h3 { font-size: 0.95rem; font-weight: 800; margin-bottom: 0.5rem; }
      .pm-title { font-size: 0.85rem; color: var(--text-muted); }
      .pm-proba { font-size: 2.2rem; font-weight: 800; color: var(--accent); margin: 0.3rem 0; }
      .pm-link { color: var(--accent); font-size: 0.85rem; text-decoration: none; font-weight: 700; }
      .pm-link:hover { text-decoration: underline; }
      .pm-disc { font-weight: 400; color: var(--text-muted); font-size: 0.75rem; }
      .pm-empty { border-style: dashed; }
      .pm-empty p { color: var(--text-muted); font-size: 0.85rem; }

      .follow { background: var(--bg-alt); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.2rem 1.3rem; margin-bottom: 1.1rem; }
      .follow h3 { font-size: 0.95rem; font-weight: 800; margin-bottom: 0.4rem; }
      .follow p { color: var(--text-muted); font-size: 0.83rem; margin-bottom: 0.8rem; }
      .follow .btn { display: block; text-align: center; margin-bottom: 0.5rem; }

      .method-side { color: var(--text-muted); font-size: 0.78rem; line-height: 1.55; }
      .method-side h3 { font-size: 0.85rem; font-weight: 800; margin-bottom: 0.3rem; color: var(--text); }
    </style>
  </BaseLayout>
