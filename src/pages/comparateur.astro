---
import BaseLayout from '../layouts/BaseLayout.astro';
import { activeAffiliates } from '../data/affiliates';
import fees from '../data/exchange-fees.json';

const partners = activeAffiliates.filter((p) => p.type && p.frais);

// Liens affiliés par plateforme (CTA du simulateur)
const feeLinks: Record<string, { url: string; cta: string; umami: string }> = {};
activeAffiliates.forEach((a) => { feeLinks[a.umami] = { url: a.url, cta: a.cta, umami: a.umami }; });

// Prix BTC/ETH au build (conversion des frais de retrait en €)
async function fetchPrice(id: string): Promise<number> {
  try {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), 6000);
    const res = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${id}&vs_currencies=eur`, { signal: ctrl.signal });
    clearTimeout(t);
    if (!res.ok) return 0;
    const data = await res.json();
    return data[id]?.eur ?? 0;
  } catch {
    return 0;
  }
}
const [btcPrice, ethPrice] = await Promise.all([fetchPrice('bitcoin'), fetchPrice('ethereum')]);
const calcData = JSON.stringify({ platforms: fees.platforms, updated: fees.updated, links: feeLinks });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: "Comparateur d'exchanges crypto — CryptoDesk",
  url: 'https://cryptodesk.fr/comparateur/',
  description: "Comparez les exchanges crypto recommandés par CryptoDesk : frais, régulation, bonus et public cible.",
  inLanguage: 'fr-FR',
};
---

<BaseLayout
  title="Comparateur d'exchanges crypto"
  description="Comparez les exchanges crypto recommandés par CryptoDesk : Bitvavo, Bitstack, OKX, WEEX, Bitget, Kraken Pro — frais, régulation, bonus et public cible."
  canonical="https://cryptodesk.fr/comparateur/"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="container">
      <h1 class="hero-title">Comparateur d'exchanges</h1>
      <p class="hero-sub">
        Les plateformes que nous recommandons, comparées sur les critères qui comptent :
        frais, régulation, bonus et profil idéal. <strong>Les frais affichés sont indicatifs</strong> —
        vérifiez toujours sur le site officiel.
      </p>
    </div>
  </section>

  <section class="container">
    <div class="calc" id="simulateur">
      <h2 class="calc-title">🧮 Combien ça coûte vraiment ?</h2>
      <p class="calc-sub">
        Le frais affiché par les exchanges (maker/taker) ne dit pas tout. Ce simulateur estime le
        <strong>coût complet</strong> : dépôt, trading, spread et retrait — pour ton scénario précis.
      </p>
      <form id="cost-calculator" class="calc-form" data-fees={calcData} data-btc-price={btcPrice} data-eth-price={ethPrice}>
        <div class="calc-grid">
          <label>Montant investi (€)
            <input type="number" name="amount" min="10" step="10" value="100" required />
          </label>
          <label>Méthode de dépôt
            <select name="method">
              <option value="transfer">Virement (SEPA)</option>
              <option value="card">Carte bancaire</option>
            </select>
          </label>
          <label>Actif acheté
            <select name="asset">
              <option value="btc">Bitcoin (BTC)</option>
              <option value="eth">Ethereum (ETH)</option>
            </select>
          </label>
          <label>Après l'achat
            <select name="withdraw">
              <option value="platform">Je garde sur la plateforme</option>
              <option value="wallet">Je retire vers mon wallet</option>
            </select>
          </label>
        </div>
        <p class="calc-hint">
          Prix de référence au build : BTC ≈ {btcPrice ? btcPrice.toLocaleString('fr-FR') + ' €' : 'n/a'} · ETH ≈ {ethPrice ? ethPrice.toLocaleString('fr-FR') + ' €' : 'n/a'}
        </p>
        <div id="calc-results"></div>
      </form>
    </div>

    <div class="table-wrap">
      <table class="compare">
        <thead>
          <tr>
            <th>Exchange</th>
            <th>Type</th>
            <th>Régulation</th>
            <th>Frais</th>
            <th>Bonus</th>
            <th>Idéal pour</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            partners.map((p) => (
              <tr>
                <td class="name">
                  <strong>{p.name}</strong>
                  <span class="pays">{p.pays}</span>
                </td>
                <td>{p.type}</td>
                <td class="ok">{p.regulation}</td>
                <td class={p.fraisClasse}>{p.frais}</td>
                <td>{p.bonus}</td>
                <td>{p.ideal}</td>
                <td>
                  <a class="cta" href={p.url} target="_blank" rel="noopener sponsored nofollow">Ouvrir →</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="note">
      <p>
        ℹ️ <strong>Liens d'affiliation :</strong> en ouvrant un compte via ces liens, vous ne payez
        pas plus cher et vous soutenez le blog. Notre classement n'est pas influencé par les commissions —
        il reflète notre expérience d'utilisation.
      </p>
      <p class="small">⚠️ Frais indicatifs au moment de la rédaction — ils peuvent évoluer. Consultez le site officiel avant de vous inscrire.</p>
    </div>
  </section>

  <script src="/js/calculateur.js" is:inline></script>

  <style>
    .hero { padding: 3.5rem 0 2.5rem; }
    .hero-title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem; }
    .hero-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 65ch; }
    .hero-sub strong { color: var(--text); }

    /* ── Simulateur de coût réel ── */
    .calc {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 1.8rem 2rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);
    }
    .calc-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 0.4rem; }
    .calc-sub { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.3rem; max-width: 65ch; }
    .calc-sub strong { color: var(--text); }
    .calc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
    .calc-grid label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; color: var(--text-muted); }
    .calc-grid input, .calc-grid select {
      padding: 0.6rem 0.8rem; border: 1px solid var(--border); border-radius: 10px;
      background: var(--bg); color: var(--text); font-size: 0.95rem;
    }
    .calc-grid input:focus, .calc-grid select:focus { outline: 2px solid var(--accent); border-color: transparent; }
    .calc-hint { color: var(--text-muted); font-size: 0.78rem; margin-top: 0.8rem; }
    .calc-empty { color: var(--text-muted); margin-top: 1.2rem; }
    .calc-best {
      margin-top: 1.3rem; padding: 0.8rem 1.1rem; border-radius: 10px;
      background: var(--accent-glow); border: 1px solid var(--accent);
      font-size: 0.95rem; color: var(--text);
    }
    .calc-best strong { color: var(--accent); }
    .calc-list { display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-top: 1rem; }
    @media (min-width: 700px) { .calc-list { grid-template-columns: 1fr 1fr; } }
    .calc-row {
      border: 1px solid var(--border); border-radius: var(--radius-sm);
      padding: 1rem 1.1rem; background: var(--bg-alt);
    }
    .calc-row.best { border-color: var(--accent); }
    .calc-row-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; }
    .calc-row-head strong { color: var(--text); }
    .calc-row-head span { color: var(--accent); font-weight: 700; font-size: 0.95rem; }
    .calc-detail { list-style: none; display: flex; flex-direction: column; gap: 0.2rem; margin-bottom: 0.6rem; }
    .calc-detail li { display: flex; justify-content: space-between; font-size: 0.82rem; color: var(--text-muted); }
    .calc-total { border-top: 1px dashed var(--border); padding-top: 0.3rem; margin-top: 0.2rem; font-weight: 700; color: var(--text); }
    .calc-cta {
      display: inline-block; margin-top: 0.4rem;
      background: var(--accent); color: #fff; font-weight: 700; font-size: 0.82rem;
      padding: 0.45rem 1rem; border-radius: 999px; text-decoration: none;
      transition: filter 0.15s;
    }
    .calc-cta:hover { filter: brightness(1.1); }
    .calc-note { color: var(--text-muted); font-size: 0.75rem; margin-top: 0.5rem; opacity: 0.9; }
    .calc-disclaimer { color: var(--text-muted); font-size: 0.75rem; margin-top: 1rem; opacity: 0.85; }

    .table-wrap { overflow-x: auto; margin-bottom: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius); }
    .compare { width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 720px; background: var(--card); }
    .compare th {
      text-align: left; padding: 0.9rem 1rem; font-size: 0.75rem; text-transform: uppercase;
      letter-spacing: 0.06em; color: var(--text-muted); border-bottom: 1px solid var(--border);
      background: var(--bg-alt); white-space: nowrap;
    }
    .compare td { padding: 1rem; border-bottom: 1px solid var(--border); color: var(--text-muted); vertical-align: top; }
    .compare tr:last-child td { border-bottom: none; }
    .compare tr:hover td { background: var(--bg-alt); }
    .compare .name { display: flex; flex-direction: column; }
    .compare .name strong { color: var(--text); font-size: 1rem; }
    .compare .pays { font-size: 0.78rem; opacity: 0.8; }
    .compare .ok { color: var(--accent); }
    .compare .faible { color: var(--accent); font-weight: 600; }
    .compare .moyen { color: inherit; }
    .cta {
      display: inline-block; background: var(--accent); color: #fff; font-weight: 700;
      font-size: 0.8rem; padding: 0.45rem 0.9rem; border-radius: 999px; text-decoration: none;
      white-space: nowrap; transition: filter 0.15s;
    }
    .cta:hover { filter: brightness(1.1); }

    .note {
      background: var(--bg-alt); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 1.25rem 1.5rem; margin-bottom: 2.5rem;
    }
    .note p { color: var(--text-muted); font-size: 0.92rem; }
    .note .small { font-size: 0.8rem; margin-top: 0.5rem; opacity: 0.85; }
  </style>
</BaseLayout>
