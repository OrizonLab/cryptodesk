---
import BaseLayout from '../layouts/BaseLayout.astro';

// Récupère les données Polymarket directement au build (fetch Node natif).
// Pas de sous-processus : fiable dans l'environnement de build Astro.

const GAMMA = 'https://gamma-api.polymarket.com';
const CLOB = 'https://clob.polymarket.com';

const MONTHS_EN = ['', 'january', 'february', 'march', 'april', 'may', 'june',
  'july', 'august', 'september', 'october', 'november', 'december'];
const MONTHS_FR = ['', 'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
  'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];

const now = new Date();
const month = now.getMonth() + 1;
const year = now.getFullYear();

async function fetchJson(url: string, timeoutMs = 8000) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const res = await fetch(url, { signal: ctrl.signal, headers: { 'User-Agent': 'cryptodesk-blog/1.0' } });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return await res.json();
  } finally {
    clearTimeout(timer);
  }
}

function cleanQ(q: string): string {
  return q.replace(/^Will the price of Bitcoin be /, '').replace(/\?$/, '').trim();
}

let polymarket: { markets: Array<{ q: string; pct: number }>; deltas: Array<{ q: string; before: number; after: number; delta: number }> } | null = null;

try {
  const query = `bitcoin above ${MONTHS_EN[month]}`;
  const data = await fetchJson(`${GAMMA}/public-search?q=${encodeURIComponent(query)}`);

  const markets: Array<{ question: string; yes: number; tokenYes: string | null }> = [];
  for (const e of data.events ?? []) {
    if (!e.title?.toLowerCase().includes(MONTHS_EN[month])) continue;
    if (!String(e.endDate ?? '').startsWith(String(year))) continue;
    for (const m of e.markets ?? []) {
      if (m.closed) continue;
      try {
        const p = JSON.parse(m.outcomePrices ?? '[]');
        const yes = parseFloat(p[0]) * 100;
        const tids = JSON.parse(m.clobTokenIds ?? '[]');
        markets.push({ question: m.question ?? '', yes, tokenYes: tids[0] ?? null });
      } catch { /* skip */ }
    }
  }

  markets.sort((a, b) => b.yes - a.yes);

  // Variations 24h — parallèle
  const deltas: Array<{ question: string; before: number; after: number; delta: number }> = [];
  await Promise.all(markets.slice(0, 20).map(async (m) => {
    if (!m.tokenYes) return;
    try {
      const hist = await fetchJson(`${CLOB}/prices-history?market=${m.tokenYes}&interval=1d&fidelity=48`);
      const h = hist.history ?? [];
      if (h.length < 2) return;
      const before = parseFloat(h[0].p) * 100;
      const after = parseFloat(h[h.length - 1].p) * 100;
      deltas.push({ question: m.question, before, after, delta: after - before });
    } catch { /* skip */ }
  }));

  polymarket = {
    markets: markets.slice(0, 6).map((m) => ({ q: cleanQ(m.question), pct: Math.round(m.yes * 10) / 10 })),
    deltas: deltas.sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta)).slice(0, 6),
  };
} catch {
  polymarket = null;
}

const dateFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const today = dateFmt.format(new Date());
---

<BaseLayout
  title="Données du jour"
  description="Les données du jour : probabilités Bitcoin sur Polymarket, variations 24h et signaux des marchés de prédiction."
  canonical="https://blog.auratrade.app/donnees/"
>
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">Données du jour</h1>
      <p class="hero-sub">
        Les chiffres qui comptent, mis à jour à chaque publication : probabilités Bitcoin
        sur les marchés de prédiction et leurs variations sur 24 h.
        <strong>Données indicatives — pas un conseil.</strong>
      </p>
    </div>
  </section>

  <section class="container">
    {
      polymarket ? (
        <>
          <p class="date">📅 {today} — {MONTHS_FR[month]} {year}</p>

          <div class="panel">
            <h2>🏆 Probabilités les plus fortes (BTC au-dessus de X)</h2>
            <div class="bars">
              {
                polymarket.markets.map((m) => (
                  <div class="bar-row">
                    <span class="bar-label">{m.q}</span>
                    <div class="bar-track">
                      <div class="bar-fill" style={`width:${Math.min(m.pct, 100)}%`}></div>
                    </div>
                    <span class="bar-value">{m.pct.toFixed(1)}%</span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="panel">
            <h2>📈 Plus fortes variations sur 24 h</h2>
            <div class="delta-list">
              {
                polymarket.deltas.map((d) => (
                  <div class="delta-row">
                    <span class={`delta-arrow ${d.delta >= 0 ? 'up' : 'down'}`}>
                      {d.delta >= 0 ? '▲' : '▼'}
                    </span>
                    <span class="delta-q">{cleanQ(d.question)}</span>
                    <span class="delta-nums">
                      {d.before.toFixed(1)}% → {d.after.toFixed(1)}%
                      <strong class={d.delta >= 0 ? 'up' : 'down'}>({d.delta >= 0 ? '+' : ''}{d.delta.toFixed(1)} pts)</strong>
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <p class="source">
            Source : <a href="https://polymarket.com" target="_blank" rel="noopener nofollow">Polymarket</a>
            (marchés de prédiction) — données indicatives, pas un conseil en investissement.
          </p>
        </>
      ) : (
        <div class="panel">
          <h2>Données indisponibles</h2>
          <p class="source">Les marchés de prédiction n'ont pas pu être récupérés lors de la dernière mise à jour.</p>
        </div>
      )
    }
  </section>

  <style>
    .hero { padding: 3.5rem 0 2.5rem; }
    .hero-title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem; }
    .hero-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 60ch; }
    .hero-sub strong { color: var(--text); }
    .date { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; }

    .panel {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 1.5rem; margin-bottom: 1.5rem;
    }
    .panel h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1.25rem; }

    .bars { display: flex; flex-direction: column; gap: 0.9rem; }
    .bar-row { display: grid; grid-template-columns: minmax(0, 1fr) 2fr auto; align-items: center; gap: 0.9rem; }
    .bar-label { font-size: 0.85rem; color: var(--text-muted); }
    .bar-track { height: 14px; background: var(--bg-alt); border-radius: 999px; overflow: hidden; }
    .bar-fill { height: 100%; background: linear-gradient(90deg, var(--accent), #6366f1); border-radius: 999px; }
    .bar-value { font-weight: 700; font-size: 0.9rem; min-width: 3.2rem; text-align: right; }

    .delta-list { display: flex; flex-direction: column; gap: 0.7rem; }
    .delta-row { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
    .delta-arrow { font-weight: 700; }
    .delta-arrow.up, .delta-nums .up { color: #22c55e; }
    .delta-arrow.down, .delta-nums .down { color: #ef4444; }
    .delta-q { font-size: 0.88rem; color: var(--text-muted); flex: 1; min-width: 200px; }
    .delta-nums { font-size: 0.85rem; color: var(--text-muted); }
    .delta-nums strong { font-weight: 700; }

    .source { color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem; }
    .source a { color: var(--accent); }
  </style>
</BaseLayout>
