---
import BaseLayout from '../layouts/BaseLayout.astro';

// Récupère les données Polymarket directement au build (fetch Node natif).
// Pas de sous-processus : fiable dans l'environnement de build Astro.

const GAMMA = 'https://gamma-api.polymarket.com';
const CLOB = 'https://clob.polymarket.com';
const COINGECKO = 'https://api.coingecko.com/api/v3/simple/price';

const MONTHS_EN = ['', 'january', 'february', 'march', 'april', 'may', 'june',
  'july', 'august', 'september', 'october', 'november', 'december'];
const MONTHS_FR = ['', 'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
  'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];

const now = new Date();
const month = now.getMonth() + 1;
const year = now.getFullYear();

async function fetchJson(url: string, timeoutMs = 8000) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const res = await fetch(url, { signal: ctrl.signal, headers: { 'User-Agent': 'cryptodesk-blog/1.0' } });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return await res.json();
  } finally {
    clearTimeout(timer);
  }
}

function cleanQ(q: string): string {
  return q.replace(/^Will the price of Bitcoin be /, '').replace(/\?$/, '').trim();
}

/** Extrait le niveau de prix d'une question « above $X » */
function extractLevel(q: string): number | null {
  const m = q.match(/above \$([\d,]+)/);
  return m ? parseInt(m[1].replace(/,/g, ''), 10) : null;
}

/** Extrait le jour d'expiration d'une question « on August N » */
function extractDay(q: string): number | null {
  const m = q.match(/on [A-Za-z]+ (\d+)/);
  return m ? parseInt(m[1], 10) : null;
}

interface BtcMarket {
  question: string;
  yes: number;
  level: number;
  day: number;
  tokenYes: string | null;
}

interface LevelAgg {
  level: number;
  avg: number;          // probabilité moyenne sur la fenêtre
  first: number;        // probabilité au jour le plus proche
  last: number;         // probabilité au jour le plus lointain
  trend: number;        // last - first (direction temporelle)
  count: number;
}

let polymarket: {
  levels: LevelAgg[];
  equilibrium: number;          // niveau à ~50 %
  equilibriumProb: number;
  spot: number | null;          // prix spot BTC
  bias: 'haussier' | 'baissier' | 'neutre';
  biasScore: number;            // somme pondérée des tendances
  conclusion: string;
  deltas: Array<{ q: string; before: number; after: number; delta: number }>;
} | null = null;

try {
  const query = `bitcoin above ${MONTHS_EN[month]}`;
  const data = await fetchJson(`${GAMMA}/public-search?q=${encodeURIComponent(query)}`);

  const markets: BtcMarket[] = [];
  for (const e of data.events ?? []) {
    if (!e.title?.toLowerCase().includes(MONTHS_EN[month])) continue;
    if (!String(e.endDate ?? '').startsWith(String(year))) continue;
    for (const m of e.markets ?? []) {
      if (m.closed) continue;
      try {
        const p = JSON.parse(m.outcomePrices ?? '[]');
        const yes = parseFloat(p[0]) * 100;
        const tids = JSON.parse(m.clobTokenIds ?? '[]');
        const level = extractLevel(m.question ?? '');
        const day = extractDay(m.question ?? '');
        if (level === null || day === null) continue;
        markets.push({ question: m.question ?? '', yes, level, day, tokenYes: tids[0] ?? null });
      } catch { /* skip */ }
    }
  }

  markets.sort((a, b) => a.level - b.level);

  // === Agrégation par niveau de prix ===
  const byLevel = new Map<number, { yes: number; day: number }[]>();
  for (const m of markets) {
    if (!byLevel.has(m.level)) byLevel.set(m.level, []);
    byLevel.get(m.level)!.push({ yes: m.yes, day: m.day });
  }

  const levels: LevelAgg[] = [];
  for (const [level, entries] of byLevel) {
    if (entries.length === 0) continue;
    entries.sort((a, b) => a.day - b.day);
    const avg = entries.reduce((s, e) => s + e.yes, 0) / entries.length;
    const first = entries[0].yes;
    const last = entries[entries.length - 1].yes;
    levels.push({ level, avg, first, last, trend: last - first, count: entries.length });
  }
  levels.sort((a, b) => a.level - b.level);

  // === Point d'équilibre : interpolation linéaire autour de 50 % ===
  let equilibrium = 0;
  let equilibriumProb = 50;
  for (let i = 0; i < levels.length - 1; i++) {
    const a = levels[i];
    const b = levels[i + 1];
    if (a.avg >= 50 && b.avg <= 50) {
      const t = (a.avg - 50) / (a.avg - b.avg || 1);
      equilibrium = Math.round(a.level + (b.level - a.level) * t);
      equilibriumProb = 50;
      break;
    }
  }
  if (equilibrium === 0 && levels.length > 0) {
    // Pas de croisement : le point d'équilibre est au-delà de la grille
    if (levels[levels.length - 1].avg > 50) {
      equilibrium = levels[levels.length - 1].level + 2000;
    } else {
      equilibrium = levels[0].level;
    }
  }

  // === Prix spot BTC ===
  let spot: number | null = null;
  try {
    const s = await fetchJson(`${COINGECKO}?ids=bitcoin&vs_currencies=usd`);
    spot = s?.bitcoin?.usd ?? null;
  } catch { /* spot indisponible : conclusion sans comparaison */ }

  // === Biais directionnel : somme des tendances pondérées par la proximité à 50 % ===
  let biasScore = 0;
  let weightSum = 0;
  for (const l of levels) {
    // Poids max autour de 50 %, décroissant vers les extrêmes
    const w = 1 - Math.abs(l.avg - 50) / 100;
    if (w <= 0.15) continue;
    biasScore += l.trend * w;
    weightSum += w;
  }
  if (weightSum > 0) biasScore /= weightSum;

  const bias = biasScore > 3 ? 'haussier' : biasScore < -3 ? 'baissier' : 'neutre';

  // === Conclusion rédigée ===
  let conclusion = '';
  if (spot !== null) {
    const diff = spot - equilibrium;
    const pctDiff = Math.abs(diff) / spot * 100;
    if (bias === 'haussier') {
      conclusion = `Le marché place le point d'équilibre autour de ${equilibrium.toLocaleString('fr-FR')} $, alors que le Bitcoin s'échange près de ${Math.round(spot).toLocaleString('fr-FR')} $. Les probabilités augmentent avec le temps sur les niveaux proches du point d'équilibre : le marché de prédiction anticipe plutôt une hausse dans les prochains jours.`;
    } else if (bias === 'baissier') {
      conclusion = `Le marché place le point d'équilibre autour de ${equilibrium.toLocaleString('fr-FR')} $, alors que le Bitcoin s'échange près de ${Math.round(spot).toLocaleString('fr-FR')} $. Les probabilités diminuent avec le temps sur les niveaux proches du point d'équilibre : le marché de prédiction anticipe plutôt un repli dans les prochains jours.`;
    } else {
      conclusion = `Le marché place le point d'équilibre autour de ${equilibrium.toLocaleString('fr-FR')} $, proche du prix actuel du Bitcoin (${Math.round(spot).toLocaleString('fr-FR')} $). Les probabilités sont stables dans le temps : aucune direction claire ne se dégage pour les prochains jours.`;
    }
  } else {
    conclusion = `Le marché place le point d'équilibre autour de ${equilibrium.toLocaleString('fr-FR')} $. Les probabilités ${bias === 'haussier' ? 'augmentent' : bias === 'baissier' ? 'diminuent' : 'restent stables'} avec le temps : tendance ${bias === 'neutre' ? 'incertaine' : bias} sur les prochains jours.`;
  }

  // === Niveaux pertinents à afficher : zone d'incertitude (entre ~5 % et ~95 %) ===
  const shown = levels.filter((l) => l.avg >= 5 && l.avg <= 95);

  // === Variations 24h — parallèle (top 20 marchés les plus liquides) ===
  const deltas: Array<{ q: string; before: number; after: number; delta: number }> = [];
  const forDelta = [...markets].sort((a, b) => Math.abs(b.yes - 50) - Math.abs(a.yes - 50)).slice(0, 20);
  await Promise.all(forDelta.map(async (m) => {
    if (!m.tokenYes) return;
    try {
      const hist = await fetchJson(`${CLOB}/prices-history?market=${m.tokenYes}&interval=1d&fidelity=48`);
      const h = hist.history ?? [];
      if (h.length < 2) return;
      const before = parseFloat(h[0].p) * 100;
      const after = parseFloat(h[h.length - 1].p) * 100;
      deltas.push({ q: m.question, before, after, delta: after - before });
    } catch { /* skip */ }
  }));

  polymarket = {
    levels: shown,
    equilibrium,
    equilibriumProb,
    spot,
    bias,
    biasScore: Math.round(biasScore * 10) / 10,
    conclusion,
    deltas: deltas.sort((a, b) => Math.abs(b.delta) - Math.abs(a.delta)).slice(0, 6),
  };
} catch {
  polymarket = null;
}

const dateFmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const today = dateFmt.format(new Date());

const fmtUsd = (n: number) => n.toLocaleString('fr-FR', { maximumFractionDigits: 0 });
const biasLabel = { haussier: '📈 Tendance haussière', baissier: '📉 Tendance baissière', neutre: '⚖️ Tendance neutre' } as const;
const biasClass = { haussier: 'up', baissier: 'down', neutre: 'flat' } as const;
---

<BaseLayout
  title="Données du jour"
  description="Le point d'équilibre Bitcoin sur Polymarket, la tendance anticipée par les marchés de prédiction et les variations 24h."
  canonical="https://cryptodesk.fr/donnees/"
>
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">Données du jour</h1>
      <p class="hero-sub">
        L'analyse des marchés de prédiction : point d'équilibre du Bitcoin, tendance anticipée
        et variations sur 24 h. <strong>Données indicatives — pas un conseil.</strong>
      </p>
    </div>
  </section>

  <section class="container">
    {
      polymarket ? (
        <>
          <p class="date">📅 {today} — {MONTHS_FR[month]} {year}</p>

          {/* ==== Point d'équilibre ==== */}
          <div class="panel eq-panel">
            <p class="eq-label">🎯 Point d'équilibre du marché</p>
            <p class="eq-value">{fmtUsd(polymarket.equilibrium)} $</p>
            <p class="eq-sub">
              Le niveau où le marché est indécis (~50 %) : selon Polymarket, le Bitcoin a autant
              de chances d'être au-dessus qu'en dessous de ce prix.
              {polymarket.spot !== null && <> Le prix actuel du BTC est de <strong>{fmtUsd(polymarket.spot)} $</strong>.</>}
            </p>
            <div class={`bias-badge ${biasClass[polymarket.bias]}`}>
              {biasLabel[polymarket.bias]}
            </div>
          </div>

          {/* ==== Conclusion ==== */}
          <div class="panel conclusion-panel">
            <h2>💡 Ce que ça signifie</h2>
            <p class="conclusion-text">{polymarket.conclusion}</p>
          </div>

          {/* ==== Barres : zone d'incertitude ==== */}
          {
            polymarket.levels.length > 0 && (
              <div class="panel">
                <h2>📊 Probabilités par niveau (zone d'incertitude)</h2>
                <p class="panel-note">
                  Seuls les niveaux où le marché n'a pas tranché (5 à 95 %) sont affichés — les extrêmes
                  (proches de 0 ou 100 %) n'apportent pas d'information.
                </p>
                <div class="bars">
                  {
                    polymarket.levels.map((l) => (
                      <div class="bar-row">
                        <span class="bar-label">BTC &gt; {fmtUsd(l.level)} $</span>
                        <div class="bar-track">
                          <div class="bar-fill" style={`width:${Math.min(l.avg, 100)}%`}></div>
                        </div>
                        <span class="bar-value">{l.avg.toFixed(1)}%</span>
                        <span class={`trend ${l.trend >= 0 ? 'up' : 'down'}`}>
                          {l.trend >= 0 ? '▲' : '▼'} {Math.abs(l.trend).toFixed(1)} pts
                        </span>
                      </div>
                    ))
                  }
                </div>
                <p class="trend-note">
                  ▲/▼ = évolution de la probabilité entre le jour le plus proche et le plus lointain.
                  Une probabilité qui <strong>monte</strong> dans le temps signale un marché qui voit le prix
                  <strong> grimper</strong> ; qui <strong>descend</strong>, un marché qui le voit <strong>reculer</strong>.
                </p>
              </div>
            )
          }

          {/* ==== Variations 24h ==== */}
          {
            polymarket.deltas.length > 0 && (
              <div class="panel">
                <h2>📈 Plus fortes variations sur 24 h</h2>
                <div class="delta-list">
                  {
                    polymarket.deltas.map((d) => (
                      <div class="delta-row">
                        <span class={`delta-arrow ${d.delta >= 0 ? 'up' : 'down'}`}>
                          {d.delta >= 0 ? '▲' : '▼'}
                        </span>
                        <span class="delta-q">{cleanQ(d.q)}</span>
                        <span class="delta-nums">
                          {d.before.toFixed(1)}% → {d.after.toFixed(1)}%
                          <strong class={d.delta >= 0 ? 'up' : 'down'}>({d.delta >= 0 ? '+' : ''}{d.delta.toFixed(1)} pts)</strong>
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
            )
          }

          <p class="source">
            Source : <a href="https://polymarket.com" target="_blank" rel="noopener nofollow">Polymarket</a>
            (marchés de prédiction) — données indicatives, pas un conseil en investissement.
          </p>
        </>
      ) : (
        <div class="panel">
          <h2>Données indisponibles</h2>
          <p class="source">Les marchés de prédiction n'ont pas pu être récupérés lors de la dernière mise à jour.</p>
        </div>
      )
    }
  </section>

  <style>
    .hero { padding: 3.5rem 0 2.5rem; }
    .hero-title { font-size: clamp(1.9rem, 4.5vw, 2.8rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem; }
    .hero-sub { color: var(--text-muted); font-size: 1.05rem; max-width: 60ch; }
    .hero-sub strong { color: var(--text); }
    .date { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; }

    .panel {
      background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);
    }
    .panel h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; }
    .panel-note { color: var(--text-muted); font-size: 0.82rem; margin-bottom: 1.1rem; }

    /* Point d'équilibre */
    .eq-panel {
      text-align: center;
      background: linear-gradient(135deg, var(--card) 70%, var(--accent-glow));
      border: 1px solid var(--accent-glow);
      padding: 2rem 1.5rem;
    }
    .eq-label { color: var(--text-muted); font-size: 0.9rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; margin-bottom: 0.6rem; }
    .eq-value {
      font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.02em;
      background: linear-gradient(120deg, var(--accent), #6366f1);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
      margin-bottom: 0.8rem;
    }
    .eq-sub { color: var(--text-muted); font-size: 0.92rem; max-width: 52ch; margin: 0 auto 1.2rem; }
    .eq-sub strong { color: var(--text); }

    .bias-badge {
      display: inline-block; padding: 0.4rem 1.1rem; border-radius: 999px;
      font-weight: 700; font-size: 0.9rem;
    }
    .bias-badge.up { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
    .bias-badge.down { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .bias-badge.flat { background: var(--accent-glow); color: var(--accent); }

    /* Conclusion */
    .conclusion-text { font-size: 1rem; line-height: 1.75; }
    .conclusion-text strong { color: var(--accent); }

    /* Barres */
    .bars { display: flex; flex-direction: column; gap: 0.9rem; }
    .bar-row { display: grid; grid-template-columns: minmax(0, 1fr) 2fr auto auto; align-items: center; gap: 0.9rem; }
    .bar-label { font-size: 0.85rem; color: var(--text-muted); white-space: nowrap; }
    .bar-track { height: 14px; background: var(--bg-alt); border-radius: 999px; overflow: hidden; }
    .bar-fill { height: 100%; background: linear-gradient(90deg, var(--accent), #6366f1); border-radius: 999px; }
    .bar-value { font-weight: 700; font-size: 0.9rem; min-width: 3.2rem; text-align: right; }
    .trend { font-size: 0.78rem; font-weight: 700; min-width: 4.5rem; text-align: right; }
    .trend.up { color: #22c55e; }
    .trend.down { color: #ef4444; }
    .trend-note { color: var(--text-muted); font-size: 0.8rem; margin-top: 1rem; }
    .trend-note strong { color: var(--text); }

    /* Variations */
    .delta-list { display: flex; flex-direction: column; gap: 0.7rem; }
    .delta-row { display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
    .delta-arrow { font-weight: 700; }
    .delta-arrow.up, .delta-nums .up { color: #22c55e; }
    .delta-arrow.down, .delta-nums .down { color: #ef4444; }
    .delta-q { font-size: 0.88rem; color: var(--text-muted); flex: 1; min-width: 200px; }
    .delta-nums { font-size: 0.85rem; color: var(--text-muted); }
    .delta-nums strong { font-weight: 700; }

    .source { color: var(--text-muted); font-size: 0.8rem; margin-top: 0.5rem; }
    .source a { color: var(--accent); }

    @media (max-width: 640px) {
      .bar-row { grid-template-columns: 1fr 2fr auto; }
      .trend { display: none; }
    }
  </style>
</BaseLayout>
